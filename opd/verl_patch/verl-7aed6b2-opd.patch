+import sys
+import types
+from unittest.mock import patch
+
+try:
+    import pyext  # noqa: F401
+except ModuleNotFoundError:
+    pyext_stub = types.ModuleType("pyext")
+    pyext_stub.RuntimeModule = object
+    sys.modules["pyext"] = pyext_stub
+
+from verl.utils.reward_score import default_compute_score
+from verl.utils.reward_score.prime_code import compute_score
+
+
+def make_tests(size: int = 12) -> dict:
+    return {
+        "inputs": [f"{index}\n" for index in range(size)],
+        "outputs": [f"{index}\n" for index in range(size)],
+    }
+
+
+def test_continuous_uses_one_child_and_exactly_ten_tests():
+    observed = {}
+
+    def fake_check(*, in_outs, generation, timeout, debug):
+        observed["in_outs"] = in_outs
+        observed["generation"] = generation
+        return [True] * 7 + [False] * 3, [{"case": index} for index in range(10)]
+
+    with patch(
+        "verl.utils.reward_score.prime_code.apps_check_correctness",
+        side_effect=fake_check,
+    ) as check:
+        score, metadata = compute_score(
+            "```python\nprint(input())\n```",
+            make_tests(),
+            continuous=True,
+        )
+
+    assert check.call_count == 1
+    assert len(observed["in_outs"]["inputs"]) == 10
+    assert score == 0.7
+    assert metadata[0]["passed"] == 7
+    assert metadata[0]["total"] == 10
+
+
+def test_missing_fence_is_format_error():
+    with patch("verl.utils.reward_score.prime_code.apps_check_correctness") as check:
+        score, metadata = compute_score("print(1)", make_tests(), continuous=True)
+
+    assert score == 0.0
+    assert metadata[0]["status"] == "format_error"
+    check.assert_not_called()
+
+
+def test_noncontinuous_is_binary():
+    with patch(
+        "verl.utils.reward_score.prime_code.apps_check_correctness",
+        return_value=([True, False], [{}, {}]),
+    ):
+        score, _ = compute_score(
+            "```python\nprint(input())\n```",
+            make_tests(2),
+            continuous=False,
+        )
+    assert score == 0.0
+
+
+def test_rstar_route_uses_local_prime_without_sandbox_url():
+    with patch(
+        "verl.utils.reward_score.prime_code.compute_score",
+        return_value=(0.6, [{"status": "ok"}]),
+    ) as local_reward:
+        score = default_compute_score(
+            data_source="rstar_code_grpo",
+            solution_str="```python\nprint(1)\n```",
+            ground_truth=make_tests(10),
+        )
+
+    assert score == 0.6
+    local_reward.assert_called_once()
