+"""Per-sample importance weights for prioritized replay.
+
+A replay update trains on a subset of the replay buffer drawn by independent
+Bernoulli trials, so response ``i`` enters with inclusion probability
+``q_i``.  The quantity the arms must agree on is the buffer's token-mean
+objective, whose Horvitz-Thompson ratio estimator is
+
+    sum_{i in S} (1 / q_i) * sum_t loss_it   /   sum_{i in S} (1 / q_i) * D_i
+
+with ``D_i`` the number of tokens response ``i`` contributes to the loss.
+Bernoulli draws are used precisely so that the inclusion probability equals
+the sampling probability; under without-replacement sampling that fills a
+token budget exactly, ``1 / q_i`` would not be the right weight.
+
+The weight therefore has to scale the numerator *and* the denominator.  Using
+the unweighted token count as the denominator while weighting the numerator
+would tilt the update towards long responses, which is exactly the bias the
+length-prioritized arm is supposed to be free of.  Both sides derive their
+weights from the helpers here so the two cannot drift apart.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+__all__ = [
+    "REPLAY_WEIGHT_KEY",
+    "per_sample_rms_k1",
+    "per_sample_token_count",
+    "weighted_token_count",
+]
+
+# Key under which the per-sample weight 1/q_i is carried through the batch.
+REPLAY_WEIGHT_KEY = "replay_is_weights"
+
+
+def per_sample_token_count(loss_mask: torch.Tensor) -> torch.Tensor:
+    """Return the per-sample loss token count ``D_i`` as a 1-D float tensor."""
+    if loss_mask.is_nested:
+        return torch.stack([row.sum() for row in loss_mask.unbind()]).float()
+    if loss_mask.dim() == 1:
+        return loss_mask.reshape(1, -1).sum(-1).float()
+    return loss_mask.flatten(1).sum(-1).float()
+
+
+def per_sample_rms_k1(
+    student_log_probs: torch.Tensor,
+    teacher_log_probs: torch.Tensor,
+    loss_mask: torch.Tensor,
+    *,
+    clamp: float = 10.0,
+) -> torch.Tensor:
+    """Root-mean-square K1 per response, over the tokens the loss covers.
+
+    ``k_it = log pi_teacher - log pi_student`` on the student's own sampled
+    actions, so ``-(1/D_i) sum_t k_it`` estimates the sampled reverse KL.  That
+    signed mean is not the quantity wanted here: a response whose tokens
+    disagree in both directions cancels down to nearly zero while still
+    contributing large per-token gradients.  The magnitude that actually
+    multiplies the OPD gradient is the RMS,
+
+        R_i = sqrt( (1 / D_i) * sum_t k_it^2 ),
+
+    which under roughly uncorrelated token gradients gives
+    ``||G_i||^2 ~ D_i R_i^2`` and hence ``q_i ~ R_i`` at the cost-constrained
+    optimum.
+
+    The clamp bounds ``|k_it|`` the way the objective does, so a handful of
+    very low-probability tokens cannot decide a response's priority.  Responses
+    with no loss tokens return zero, which the sampler maps onto its floor
+    rather than making them unselectable.
+    """
+    mask = loss_mask.to(dtype=student_log_probs.dtype)
+    difference = (teacher_log_probs - student_log_probs).clamp(-clamp, clamp)
+    squared = (difference * difference * mask).flatten(1).sum(-1)
+    counts = mask.flatten(1).sum(-1)
+    return torch.sqrt(squared / counts.clamp(min=1.0)).float()
+
+
+def weighted_token_count(loss_mask: torch.Tensor, weights: Optional[torch.Tensor]) -> torch.Tensor:
+    """Return the token-mean denominator, weighted by ``weights`` when present.
+
+    With ``weights=None`` this is the plain token count, so non-replay runs are
+    numerically unchanged.
+    """
+    if weights is None:
+        return loss_mask.sum()
+
+    per_sample = per_sample_token_count(loss_mask)
+    weights = weights.reshape(-1).to(device=per_sample.device, dtype=per_sample.dtype)
+    if weights.shape != per_sample.shape:
+        raise ValueError(
+            f"replay weights must be one per sample, got {tuple(weights.shape)} for {tuple(per_sample.shape)} samples"
+        )
+    return (per_sample * weights).sum()
