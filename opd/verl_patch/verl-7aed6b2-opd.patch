index 0000000..8353f0d
--- /dev/null
+++ b/tests/trainer/test_replay_sampler_on_cpu.py
@@ -0,0 +1,259 @@
+"""Correctness tests for the OPD replay sampler.
+
+The sampler exists to make a length-prioritized replay arm comparable to a
+uniform one, so what has to hold is the estimator, not just the plumbing:
+Bernoulli inclusion at ``q_i`` must make ``1 / q_i`` an unbiased weight, and
+the token-mean denominator must carry the same weight as the numerator.
+"""
+
+import numpy as np
+import pytest
+import torch
+
+from verl.trainer.ppo.replay import (
+    ReplayConfig,
+    ReplaySchedule,
+    solve_inclusion_probabilities,
+)
+from verl.utils.replay_weights import per_sample_token_count, weighted_token_count
+
+GAMMA = 0.75
+
+
+def _costs(rng, n=400):
+    # Response lengths in OPD are heavy-tailed, which is the regime that makes
+    # the denominator correction matter.
+    return np.clip(rng.lognormal(mean=7.0, sigma=0.9, size=n), 32, 16384)
+
+
+@pytest.mark.parametrize("gamma", [0.0, 0.5, GAMMA, 1.0])
+@pytest.mark.parametrize("budget_frac", [0.1, 0.25, 0.5, 0.9])
+def test_budget_is_met_in_expectation(gamma, budget_frac):
+    rng = np.random.default_rng(0)
+    costs = _costs(rng)
+    budget = budget_frac * costs.sum()
+
+    q = solve_inclusion_probabilities(costs, budget, priority_exponent=gamma, min_inclusion_prob=0.02)
+
+    assert np.all(q > 0.0) and np.all(q <= 1.0)
+    assert q @ costs == pytest.approx(budget, rel=1e-6)
+
+
+def test_uniform_exponent_gives_equal_inclusion():
+    rng = np.random.default_rng(1)
+    costs = _costs(rng)
+
+    q = solve_inclusion_probabilities(costs, 0.25 * costs.sum(), priority_exponent=0.0, min_inclusion_prob=0.02)
+
+    # gamma=0 is the uniform replay arm: every response in the buffer is equally
+    # likely regardless of length, so the arms differ only in this exponent.
+    # At a quarter of the buffer's tokens that shared probability is exactly the
+    # budget fraction, which is how the uniform arm is specified.
+    assert np.allclose(q, 0.25)
+
+
+def test_priority_increases_with_length():
+    rng = np.random.default_rng(2)
+    costs = _costs(rng)
+
+    q = solve_inclusion_probabilities(costs, 0.25 * costs.sum(), priority_exponent=GAMMA, min_inclusion_prob=0.02)
+
+    order = np.argsort(costs)
+    assert np.all(np.diff(q[order]) >= -1e-12)
+    assert q[order][-1] > q[order][0]
+
+
+def test_budget_covering_buffer_selects_everything():
+    costs = np.array([100.0, 200.0, 300.0])
+
+    q = solve_inclusion_probabilities(costs, costs.sum(), priority_exponent=GAMMA, min_inclusion_prob=0.02)
+
+    assert np.allclose(q, 1.0)
+
+
+def test_saturated_probabilities_still_meet_budget():
+    # The long response cannot supply more than its own tokens, so a budget
+    # above that has to spill onto the short ones. Redistributing the capped
+    # mass is the reason the scale factor needs solving rather than a closed
+    # form.
+    costs = np.array([16000.0, 100.0, 100.0, 100.0, 100.0])
+    budget = 0.995 * costs.sum()
+
+    q = solve_inclusion_probabilities(costs, budget, priority_exponent=GAMMA, min_inclusion_prob=0.02)
+
+    assert q[0] == pytest.approx(1.0)
+    assert q[1:].max() < 1.0
+    assert q @ costs == pytest.approx(budget, rel=1e-6)
+
+
+@pytest.mark.parametrize("gamma", [0.0, GAMMA])
+def test_inverse_probability_weights_are_unbiased(gamma):
+    rng = np.random.default_rng(3)
+    costs = _costs(rng, n=200)
+    q = solve_inclusion_probabilities(costs, 0.25 * costs.sum(), priority_exponent=gamma, min_inclusion_prob=0.02)
+
+    # An arbitrary per-response quantity; the weighted sum over a draw should
+    # recover its buffer total.
+    signal = rng.normal(size=costs.size) * costs
+    draw_rng = np.random.default_rng(4)
+    trials = 4000
+    estimates = np.empty(trials)
+    for t in range(trials):
+        keep = draw_rng.random(costs.size) < q
+        estimates[t] = ((1.0 / q[keep]) * signal[keep]).sum()
+
+    truth = signal.sum()
+    stderr = estimates.std(ddof=1) / np.sqrt(trials)
+    assert abs(estimates.mean() - truth) < 4.0 * stderr
+
+
+def test_weighted_token_count_is_unbiased_for_buffer_tokens():
+    rng = np.random.default_rng(5)
+    costs = _costs(rng, n=200)
+    q = solve_inclusion_probabilities(costs, 0.25 * costs.sum(), priority_exponent=GAMMA, min_inclusion_prob=0.02)
+
+    draw_rng = np.random.default_rng(6)
+    trials = 4000
+    estimates = np.empty(trials)
+    for t in range(trials):
+        keep = draw_rng.random(costs.size) < q
+        estimates[t] = ((1.0 / q[keep]) * costs[keep]).sum()
+
+    stderr = estimates.std(ddof=1) / np.sqrt(trials)
+    assert abs(estimates.mean() - costs.sum()) < 4.0 * stderr
+
+
+def test_unweighted_denominator_biases_token_mean_but_weighted_does_not():
+    """The correctness point that motivates weighting ``batch_num_tokens``.
+
+    Under length-prioritized sampling, normalizing by the plain token count of
+    the drawn subset tilts the token-mean objective towards long responses.
+    Weighting both sides removes the tilt.
+    """
+    rng = np.random.default_rng(7)
+    costs = _costs(rng, n=300)
+    # Per-token loss that falls with length, so a length-biased denominator
+    # shows up as an underestimate of the buffer's token-mean loss.
+    per_token_loss = 1.0 / (1.0 + costs / 2000.0)
+    response_loss = per_token_loss * costs
+    truth = response_loss.sum() / costs.sum()
+
+    q = solve_inclusion_probabilities(costs, 0.25 * costs.sum(), priority_exponent=GAMMA, min_inclusion_prob=0.02)
+    draw_rng = np.random.default_rng(8)
+    trials = 3000
+    weighted = np.empty(trials)
+    unweighted = np.empty(trials)
+    for t in range(trials):
+        keep = draw_rng.random(costs.size) < q
+        w = 1.0 / q[keep]
+        weighted[t] = (w * response_loss[keep]).sum() / (w * costs[keep]).sum()
+        unweighted[t] = (w * response_loss[keep]).sum() / costs[keep].sum()
+
+    weighted_err = abs(weighted.mean() - truth) / truth
+    unweighted_err = abs(unweighted.mean() - truth) / truth
+    assert weighted_err < 0.005
+    assert unweighted_err > 0.1
+    assert unweighted_err > 20 * weighted_err
+
+
+def test_weighted_token_count_matches_manual_sum():
+    loss_mask = torch.zeros(3, 10)
+    loss_mask[0, :4] = 1
+    loss_mask[1, :7] = 1
+    loss_mask[2, :10] = 1
+    weights = torch.tensor([1.0, 2.0, 4.0])
+
+    assert torch.equal(per_sample_token_count(loss_mask), torch.tensor([4.0, 7.0, 10.0]))
+    assert weighted_token_count(loss_mask, None).item() == pytest.approx(21.0)
+    assert weighted_token_count(loss_mask, weights).item() == pytest.approx(4.0 + 14.0 + 40.0)
+
+
+def test_weighted_token_count_handles_nested_mask():
+    loss_mask = torch.nested.as_nested_tensor(
+        [torch.ones(4), torch.ones(7), torch.ones(10)], layout=torch.jagged
+    )
+    weights = torch.tensor([1.0, 2.0, 4.0])
+
+    assert weighted_token_count(loss_mask, weights).item() == pytest.approx(4.0 + 14.0 + 40.0)
+
+
+def test_weighted_token_count_rejects_shape_mismatch():
+    with pytest.raises(ValueError):
+        weighted_token_count(torch.ones(3, 5), torch.ones(2))
+
+
+def test_floor_binds_for_the_shortest_responses():
+    rng = np.random.default_rng(9)
+    costs = _costs(rng)
+    q_min = 0.05
+
+    q = solve_inclusion_probabilities(
+        costs, 0.25 * costs.sum(), priority_exponent=GAMMA, min_inclusion_prob=q_min
+    )
+
+    # Without a floor the shortest responses would take an unbounded weight, so
+    # what has to hold is that the floor binds and the budget is still met.
+    assert q.min() == pytest.approx(q_min)
+    assert (1.0 / q).max() == pytest.approx(1.0 / q_min)
+    assert q @ costs == pytest.approx(0.25 * costs.sum(), rel=1e-6)
+
+
+def test_floor_above_the_budget_degrades_to_uniform():
+    rng = np.random.default_rng(10)
+    costs = _costs(rng)
+
+    # A floor of 0.5 already spends more than a quarter of the buffer, so no
+    # response can be given more than the floor.
+    q = solve_inclusion_probabilities(
+        costs, 0.25 * costs.sum(), priority_exponent=GAMMA, min_inclusion_prob=0.5
+    )
+
+    assert np.allclose(q, 0.5)
+
+
+def test_current_batch_schedule_replays_from_the_first_cycle():
+    # Depth one: the fresh batch just pushed is the whole buffer, so there is no
+    # warmup and every cycle is one fresh update plus three replays.
+    schedule = ReplaySchedule(buffer_batches=1, updates_per_cycle=4)
+
+    assert [schedule.replay_updates_after(i) for i in range(1, 5)] == [3, 3, 3, 3]
+
+
+def test_deeper_buffer_waits_until_it_is_full():
+    schedule = ReplaySchedule(buffer_batches=4, updates_per_cycle=4)
+
+    # No draw may come from a partially filled buffer.
+    assert [schedule.replay_updates_after(i) for i in range(1, 4)] == [0, 0, 0]
+    assert [schedule.replay_updates_after(i) for i in range(4, 8)] == [3, 3, 3, 3]
+
+
+@pytest.mark.parametrize(("steps", "expected_updates"), [(1, 4), (10, 40), (25, 100)])
+def test_optimizer_updates_per_step_count(steps, expected_updates):
+    # The arms are matched on optimizer updates, so the step budget for a replay
+    # arm is derived from this relation and has to be exact.
+    schedule = ReplaySchedule(buffer_batches=1, updates_per_cycle=4)
+
+    updates = sum(1 + schedule.replay_updates_after(n) for n in range(1, steps + 1))
+
+    assert updates == expected_updates
+
+
+def test_fresh_only_schedule_never_replays():
+    schedule = ReplaySchedule(buffer_batches=1, updates_per_cycle=1)
+
+    assert [schedule.replay_updates_after(i) for i in range(1, 9)] == [0] * 8
+
+
+def test_config_rejects_budget_deeper_than_buffer():
+    with pytest.raises(ValueError):
+        ReplayConfig(enable=True, buffer_batches=1, token_budget_fraction=1.5)
+
+
+def test_config_allows_a_full_batch_budget_at_matching_depth():
+    ReplayConfig(enable=True, buffer_batches=4, token_budget_fraction=4.0)
+
+
+def test_config_defaults_are_inert_when_disabled():
+    # A disabled config must not validate or constrain anything, so non-replay
+    # runs cannot fail at startup.
+    ReplayConfig(enable=False, buffer_batches=0, updates_per_cycle=0, min_inclusion_prob=5.0)
