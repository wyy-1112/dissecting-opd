+import asyncio
+import os
+import time
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+import ray
+import torch
+from omegaconf import OmegaConf
+from tensordict import TensorDict
+
+from verl.experimental.agent_loop.agent_loop import AgentLoopWorker
+from verl.experimental.reward_loop.reward_manager.naive import NaiveRewardManager
+from verl.experimental.reward_loop.reward_manager.remote import RemoteRewardManager
+from verl.protocol import DataProto
+from verl.trainer.ppo.ray_trainer import _align_token_values_to_response
+from verl.utils.rollout_trace import RolloutTraceConfig
+
+
+class _Tokenizer:
+    def decode(self, _token_ids, skip_special_tokens=True):
+        del skip_special_tokens
+        return "```python\nwhile True: pass\n```"
+
+
+def _slow_score(**_kwargs):
+    time.sleep(0.2)
+    return {"score": 0.0}
+
+
+def _fast_score(**_kwargs):
+    return {"score": 1.0}
+
+
+def _reward_data() -> DataProto:
+    return DataProto(
+        batch=TensorDict(
+            {
+                "responses": torch.tensor([[1, 2]]),
+                "attention_mask": torch.tensor([[1, 1, 1]]),
+            },
+            batch_size=1,
+        ),
+        non_tensor_batch={
+            "data_source": np.array(["fault-injection"], dtype=object),
+            "reward_model": np.array([{"ground_truth": "{}"}], dtype=object),
+            "extra_info": np.array([{"sample_id": "judge-hang"}], dtype=object),
+        },
+    )
+
+
+class TestOPDValidationResilience(unittest.TestCase):
+    def test_naive_reward_timeout_identifies_sample(self):
+        async def scenario():
+            manager = NaiveRewardManager(
+                OmegaConf.create({"reward": {}}),
+                _Tokenizer(),
+                _slow_score,
+            )
+            with self.assertRaisesRegex(
+                TimeoutError,
+                "sample_id='judge-hang'",
+            ):
+                await manager.run_single(_reward_data())
+
+        with patch.dict(os.environ, {"VERL_REWARD_RPC_TIMEOUT_SECONDS": "0.05"}):
+            asyncio.run(scenario())
+
+    def test_agent_loop_timeout_identifies_sample(self):
+        async def scenario():
+            RolloutTraceConfig.init(None, None, None, False, None)
+            worker = AgentLoopWorker.__new__(AgentLoopWorker)
+            worker.rollout_config = OmegaConf.create(
+                {
+                    "temperature": 1.0,
+                    "top_p": 1.0,
+                    "top_k": -1,
+                    "calculate_log_probs": False,
+                    "val_kwargs": {
+                        "top_p": 1.0,
+                        "top_k": -1,
+                        "temperature": 0.0,
+                    },
+                    "agent": {"default_agent_loop": "single_turn_agent"},
+                }
+            )
+
+            async def hang(*_args, **_kwargs):
+                await asyncio.sleep(10)
+
+            worker._run_agent_loop = hang
+            worker._postprocess = lambda outputs, **_kwargs: outputs
+            batch = DataProto(
+                non_tensor_batch={
+                    "raw_prompt": np.array(
+                        [[{"role": "user", "content": "x"}]],
+                        dtype=object,
+                    ),
+                    "agent_name": np.array(["single_turn_agent"], dtype=object),
+                    "index": np.array([17]),
+                },
+                meta_info={"validate": True, "global_steps": 0},
+            )
+            with self.assertRaisesRegex(TimeoutError, "sample_id=17"):
+                await worker.generate_sequences(batch)
+
+        with patch.dict(
+            os.environ,
+            {
+                "VERL_AGENT_SAMPLE_TIMEOUT_SECONDS": "0.05",
+                "VERL_AGENT_PROGRESS_INTERVAL_SECONDS": "0.01",
+            },
+        ):
+            asyncio.run(scenario())
+
+    def test_remote_manager_creates_one_child_per_outer_worker(self):
+        ray_address = os.environ.pop("RAY_ADDRESS", None)
+        try:
+            ray.init(address="local", num_cpus=1, include_dashboard=False)
+            manager = RemoteRewardManager(
+                OmegaConf.create({"reward": {"num_workers": 16}}),
+                _Tokenizer(),
+                _fast_score,
+            )
+            self.assertFalse(isinstance(manager.reward_worker, list))
+            ray.kill(manager.reward_worker, no_restart=True)
+        finally:
+            ray.shutdown()
+            if ray_address is not None:
+                os.environ["RAY_ADDRESS"] = ray_address
+
+    def test_full_sequence_logprobs_are_aligned_to_response_tail(self):
+        response_mask = torch.ones((2, 4), dtype=torch.bool)
+        full_sequence = torch.arange(16, dtype=torch.float32).reshape(2, 8, 1)
+
+        aligned = _align_token_values_to_response(
+            full_sequence,
+            response_mask,
+            key="teacher_logprobs",
+        )
+
+        torch.testing.assert_close(
+            aligned,
+            full_sequence.squeeze(-1)[:, -4:],
+        )
+        with self.assertRaisesRegex(ValueError, "shorter than"):
+            _align_token_values_to_response(
+                torch.zeros((2, 3)),
+                response_mask,
+                key="short_values",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
