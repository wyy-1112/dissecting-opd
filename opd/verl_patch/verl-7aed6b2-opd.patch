+import math
+from types import SimpleNamespace
+
+import pytest
+import torch
+from tensordict import TensorDict
+
+from verl.trainer.distillation.losses import (
+    compute_distillation_loss_reverse_kl_estimator,
+)
+from verl.trainer.distillation.virtual_teacher import (
+    binary_stop_reverse_kl,
+    decompose_sampled_full_teacher_k1,
+    decompose_sampled_k1_by_event,
+    gather_token_logprobs,
+    mix_virtual_teacher_logprobs,
+    parse_stop_token_ids,
+)
+
+
+def test_parse_stop_token_ids_keeps_order_and_drops_duplicates():
+    assert parse_stop_token_ids("151645,151643,151645") == [151645, 151643]
+    assert parse_stop_token_ids([151645, 151643]) == [151645, 151643]
+
+
+def test_user_three_way_table_matches_the_written_targets():
+    # Vocabulary: stop, A, B. The numbers are the user's worked example.
+    student = torch.tensor([0.40, 0.45, 0.15])
+    teacher = torch.tensor([0.10, 0.18, 0.72])
+    student_log = student.log()
+    teacher_log = teacher.log()
+    student_stop = student_log[:1].unsqueeze(0)
+    teacher_stop = teacher_log[:1].unsqueeze(0)
+
+    stop_only_on_a = mix_virtual_teacher_logprobs(
+        mode="teacher_stop",
+        sampled_logprob_teacher=teacher_log[1:2],
+        sampled_logprob_student=student_log[1:2],
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([False]),
+    )
+    stop_only_on_stop = mix_virtual_teacher_logprobs(
+        mode="teacher_stop",
+        sampled_logprob_teacher=teacher_log[0:1],
+        sampled_logprob_student=student_log[0:1],
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([True]),
+    )
+    continue_only_on_a = mix_virtual_teacher_logprobs(
+        mode="teacher_continue",
+        sampled_logprob_teacher=teacher_log[1:2],
+        sampled_logprob_student=student_log[1:2],
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([False]),
+    )
+    continue_only_on_stop = mix_virtual_teacher_logprobs(
+        mode="teacher_continue",
+        sampled_logprob_teacher=teacher_log[0:1],
+        sampled_logprob_student=student_log[0:1],
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([True]),
+    )
+    continue_only_on_b = mix_virtual_teacher_logprobs(
+        mode="teacher_continue",
+        sampled_logprob_teacher=teacher_log[2:3],
+        sampled_logprob_student=student_log[2:3],
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([False]),
+    )
+
+    assert math.isclose(stop_only_on_a.exp().item(), 0.675, rel_tol=1e-6)
+    assert math.isclose(stop_only_on_stop.exp().item(), 0.10, rel_tol=1e-6)
+    assert math.isclose(continue_only_on_a.exp().item(), 0.12, rel_tol=1e-6)
+    assert math.isclose(continue_only_on_stop.exp().item(), 0.40, rel_tol=1e-6)
+    assert math.isclose(continue_only_on_b.exp().item(), 0.48, rel_tol=1e-6)
+
+
+def test_two_stop_tokens_collapse_to_one_stop_event():
+    # stop1=0.05, stop2=0.05, A=0.90 for the student; teacher stop mass is 0.40.
+    student_token = torch.tensor([math.log(0.90)])
+    teacher_token = torch.tensor([math.log(0.30)])
+    student_stop = torch.tensor([[math.log(0.05), math.log(0.05)]])
+    teacher_stop = torch.tensor([[math.log(0.25), math.log(0.15)]])
+
+    mixed = mix_virtual_teacher_logprobs(
+        mode="teacher_stop",
+        sampled_logprob_teacher=teacher_token,
+        sampled_logprob_student=student_token,
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([False]),
+    )
+    expected = (1.0 - 0.40) * (0.90 / (1.0 - 0.10))
+    assert math.isclose(mixed.exp().item(), expected, rel_tol=1e-6)
+
+
+def test_student_inputs_are_detached_from_the_target():
+    student_token = torch.tensor([math.log(0.45)], requires_grad=True)
+    teacher_token = torch.tensor([math.log(0.18)])
+    student_stop = torch.tensor([[math.log(0.40)]], requires_grad=True)
+    teacher_stop = torch.tensor([[math.log(0.10)]])
+
+    mixed = mix_virtual_teacher_logprobs(
+        mode="teacher_stop",
+        sampled_logprob_teacher=teacher_token,
+        sampled_logprob_student=student_token,
+        stop_logprobs_teacher=teacher_stop,
+        stop_logprobs_student=student_stop,
+        sampled_is_stop=torch.tensor([False]),
+    )
+    assert mixed.grad_fn is None
+
+
+def test_sampled_full_k1_is_exact_sum_of_stop_and_continue_components():
+    # Vocabulary: stop, A, B. Exercise both a sampled stop token and two
+    # sampled continue tokens on the same batch of positions.
+    student = torch.tensor(
+        [
+            [0.40, 0.45, 0.15],
+            [0.20, 0.30, 0.50],
+            [0.10, 0.20, 0.70],
+        ]
+    )
+    teacher = torch.tensor(
+        [
+            [0.10, 0.18, 0.72],
+            [0.35, 0.25, 0.40],
+            [0.25, 0.60, 0.15],
+        ]
+    )
+    sampled_ids = torch.tensor([0, 1, 2])
+    positions = torch.arange(sampled_ids.numel())
+    student_log = student.log()
+    teacher_log = teacher.log()
+
+    full, stop_component, continue_component = (
+        decompose_sampled_full_teacher_k1(
+            sampled_logprob_teacher=teacher_log[positions, sampled_ids],
+            sampled_logprob_student=student_log[positions, sampled_ids],
+            stop_logprobs_teacher=teacher_log[:, :1],
+            stop_logprobs_student=student_log[:, :1],
+            sampled_is_stop=sampled_ids == 0,
+        )
+    )
+
+    torch.testing.assert_close(full, stop_component + continue_component)
+    # teacher_continue keeps the student's exact stop-token probability.
+    assert continue_component[0].item() == pytest.approx(0.0, abs=1e-7)
+    # teacher_stop keeps the teacher's exact sampled stop-token probability.
+    assert stop_component[0].item() == pytest.approx(full[0].item())
+
+
+def test_sampled_k1_is_event_plus_within_event_for_stop_and_continue():
+    # Two stop atoms exercise the within-stop conditional term explicitly.
+    student = torch.tensor(
+        [
+            [0.30, 0.10, 0.45, 0.15],
+            [0.05, 0.15, 0.30, 0.50],
+        ]
+    )
+    teacher = torch.tensor(
+        [
+            [0.05, 0.05, 0.18, 0.72],
+            [0.20, 0.15, 0.25, 0.40],
+        ]
+    )
+    sampled_ids = torch.tensor([0, 3])
+    positions = torch.arange(sampled_ids.numel())
+    student_log = student.log()
+    teacher_log = teacher.log()
+    full, event, within_event = decompose_sampled_k1_by_event(
+        sampled_logprob_target=teacher_log[positions, sampled_ids],
+        sampled_logprob_student=student_log[positions, sampled_ids],
+        stop_logprobs_target=teacher_log[:, :2],
+        stop_logprobs_student=student_log[:, :2],
+        sampled_is_stop=torch.tensor([True, False]),
+    )
+
+    torch.testing.assert_close(full, event + within_event)
+    assert event[0].item() == pytest.approx(math.log(0.40 / 0.10))
+    assert within_event[0].item() == pytest.approx(
+        math.log((0.30 / 0.40) / (0.05 / 0.10))
+    )
+    assert event[1].item() == pytest.approx(math.log(0.80 / 0.65))
+    assert within_event[1].item() == pytest.approx(
+        math.log((0.50 / 0.80) / (0.40 / 0.65)), abs=1e-6
+    )
+
+
+def test_binary_stop_reverse_kl_matches_exact_bernoulli_formula():
+    student_stop = torch.tensor([[math.log(0.40)]])
+    teacher_stop = torch.tensor([[math.log(0.10)]])
+    actual = binary_stop_reverse_kl(student_stop, teacher_stop)
+    expected = 0.40 * math.log(0.40 / 0.10) + 0.60 * math.log(0.60 / 0.90)
+    assert actual.item() == pytest.approx(expected, rel=1e-6)
+
+    matched = binary_stop_reverse_kl(student_stop, student_stop)
+    assert matched.item() == pytest.approx(0.0, abs=1e-8)
+
+    tiny_student = 4e-9
+    tiny_teacher = 1e-6
+    tiny_actual = binary_stop_reverse_kl(
+        torch.tensor([[math.log(tiny_student)]]),
+        torch.tensor([[math.log(tiny_teacher)]]),
+    )
+    tiny_expected = tiny_student * math.log(tiny_student / tiny_teacher) + (
+        1.0 - tiny_student
+    ) * math.log((1.0 - tiny_student) / (1.0 - tiny_teacher))
+    assert tiny_actual.item() == pytest.approx(tiny_expected, rel=1e-5)
+
+
+@pytest.mark.parametrize(
+    ("mode", "active_component_key"),
+    [
+        ("teacher_stop", "distillation/sampled_k1_teacher_stop_mean"),
+        ("teacher_continue", "distillation/sampled_k1_teacher_continue_mean"),
+    ],
+)
+def test_loss_metrics_name_raw_and_counterfactual_k1_separately(
+    mode, active_component_key
+):
+    student = torch.tensor(
+        [
+            [0.40, 0.45, 0.15],
+            [0.20, 0.30, 0.50],
+            [0.10, 0.20, 0.70],
+        ]
+    )
+    teacher = torch.tensor(
+        [
+            [0.10, 0.18, 0.72],
+            [0.35, 0.25, 0.40],
+            [0.25, 0.60, 0.15],
+        ]
+    )
+    sampled_ids = torch.tensor([0, 1, 2])
+    positions = torch.arange(sampled_ids.numel())
+    sampled_student = student.log()[positions, sampled_ids]
+    sampled_teacher = teacher.log()[positions, sampled_ids]
+
+    # no_padding_2_padding left-shifts one prompt+response flat sequence, so
+    # append one unused final model-output slot.
+    flat_student = torch.cat([sampled_student, torch.zeros(1)])
+    flat_teacher = torch.cat([sampled_teacher, torch.zeros(1)]).unsqueeze(-1)
+    flat_student_stop = torch.cat(
+        [student.log()[:, 0], torch.zeros(1)]
+    ).unsqueeze(-1)
+    flat_teacher_stop = torch.cat(
+        [teacher.log()[:, 0], torch.zeros(1)]
+    ).unsqueeze(-1)
+    data = TensorDict(
+        {
+            "prompts": torch.zeros(1, 1, dtype=torch.long),
+            "responses": sampled_ids.unsqueeze(0),
+            "attention_mask": torch.ones(1, 4, dtype=torch.long),
+            "teacher_logprobs": flat_teacher,
+            "teacher_stop_logprobs": flat_teacher_stop,
+            "response_mask": torch.ones(1, 3, dtype=torch.bool),
+        },
+        batch_size=[],
+    )
+    _, metrics = compute_distillation_loss_reverse_kl_estimator(
+        config=SimpleNamespace(),
+        distillation_config=SimpleNamespace(
+            distillation_loss=SimpleNamespace(
+                loss_mode="k1",
+                virtual_teacher_mode=mode,
+                stop_token_ids=[0],
+            )
+        ),
+        model_output={
+            "log_probs": flat_student,
+            "stop_log_probs": flat_student_stop,
+        },
+        data=data,
+    )
+
+    active = metrics["distillation/sampled_k1_active_target_mean"].aggregate()
+    assert metrics["distillation/k1_mean"].aggregate() == pytest.approx(active)
+    assert metrics[active_component_key].aggregate() == pytest.approx(active)
+    assert (
+        metrics[
+            "distillation/sampled_k1_decomposition_residual_abs_max"
+        ].aggregate()
+        < 1e-6
+    )
+    assert (
+        metrics[
+            "distillation/sampled_k1_active_component_residual_abs_max"
+        ].aggregate()
+        < 1e-6
+    )
+    assert (
+        metrics[
+            "distillation/sampled_k1_full_teacher_event_within_residual_abs_max"
+        ].aggregate()
+        < 1e-6
+    )
+    assert (
+        metrics[
+            "distillation/sampled_k1_active_target_event_within_residual_abs_max"
+        ].aggregate()
+        < 1e-6
+    )
+    assert "distillation/sampled_k1_full_teacher_mean" in metrics
+    assert "distillation/sampled_k1_full_teacher_event_mean" in metrics
+    assert "distillation/sampled_k1_full_teacher_within_event_mean" in metrics
+    assert "distillation/sampled_k1_active_target_event_mean" in metrics
+    assert "distillation/sampled_k1_active_target_within_event_mean" in metrics
+    assert "distillation/raw_teacher_logprob_mean" in metrics
+    assert "distillation/active_target_logprob_mean" in metrics
+
+
+def test_gather_token_logprobs_matches_manual_softmax():
+    logits = torch.tensor([[1.0, 2.0, 0.5, -1.0]])
+    gathered = gather_token_logprobs(logits, [0, 2])
+    expected = torch.log_softmax(logits, dim=-1)[:, [0, 2]]
+    torch.testing.assert_close(gathered, expected)
+
+
+def test_gather_token_logprobs_chunked_normalizer_matches_full_softmax():
+    generator = torch.Generator().manual_seed(7)
+    logits = torch.randn(3, 11, generator=generator, requires_grad=True)
+    gathered = gather_token_logprobs(
+        logits, [1, 5, 10], vocab_chunk_size=3
+    )
+    expected = torch.log_softmax(logits, dim=-1)[:, [1, 5, 10]]
+    torch.testing.assert_close(gathered, expected)
+
+    gathered.sum().backward()
+    assert logits.grad is not None
+    assert torch.isfinite(logits.grad).all()
+
+
+@pytest.mark.parametrize("mode", ["none", "teacher_both"])
+def test_unknown_mode_is_rejected(mode):
