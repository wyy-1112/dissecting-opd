+    def _opd_gradient_diagnostics(self) -> dict[str, Metric]:
+        """Return sharding-safe Qwen layer gradient norms for OPD analysis.
+
+        FSDP ``use_orig_params=True`` exposes original parameter names while each
+        rank still owns only shards. Summing squared shard norms over the actor
+        data-parallel group therefore reconstructs exact global group norms
+        without gathering gradients or parameters.
+        """
+        if os.environ.get("OPD_GRAD_DIAGNOSTICS", "0").strip().lower() not in {
+            "1",
+            "true",
+            "yes",
+        }:
+            return {}
+        num_layers = int(os.environ.get("OPD_GRAD_NUM_LAYERS", "0"))
+        if num_layers < 1:
+            raise ValueError("OPD_GRAD_NUM_LAYERS must be positive")
+        module = getattr(self, "module", None)
+        if module is None:
+            raise RuntimeError("OPD gradient diagnostics require engine.module")
+
+        names = [
+            "embedding",
+            *(f"layer_{index:02d}" for index in range(num_layers)),
+            "lm_head",
+            "other",
+        ]
+        device = None
+        local_sums: list[torch.Tensor | None] = [None] * len(names)
+        layer_pattern = re.compile(r"(?:^|\.)layers\.(\d+)\.")
+        for parameter_name, parameter in module.named_parameters():
+            gradient = parameter.grad
+            if gradient is None:
+                continue
+            if hasattr(gradient, "to_local"):
+                gradient = gradient.to_local()
+            device = gradient.device
+            match = layer_pattern.search(parameter_name)
+            if "embed_tokens" in parameter_name:
+                bucket = 0
+            elif match and int(match.group(1)) < num_layers:
+                bucket = 1 + int(match.group(1))
+            elif "lm_head" in parameter_name:
+                bucket = 1 + num_layers
+            else:
+                bucket = 2 + num_layers
+            squared_norm = gradient.detach().float().square().sum(dtype=torch.float64)
+            local_sums[bucket] = (
+                squared_norm
+                if local_sums[bucket] is None
+                else local_sums[bucket] + squared_norm
+            )
+
+        if device is None:
+            raise RuntimeError(
+                "OPD gradient diagnostics found no gradients; "
+                "set actor fsdp_config.use_orig_params=True"
+            )
+        packed = torch.stack(
+            [
+                value
+                if value is not None
+                else torch.zeros((), device=device, dtype=torch.float64)
+                for value in local_sums
+            ]
+        )
+        group = self._opd_gradient_reduce_group()
+        if dist.is_available() and dist.is_initialized():
+            dist.all_reduce(packed, op=dist.ReduceOp.SUM, group=group)
