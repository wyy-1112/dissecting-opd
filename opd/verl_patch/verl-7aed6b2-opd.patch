index 0000000..f7806b7
--- /dev/null
+++ b/verl/trainer/distillation/loss_masks.py
@@ -0,0 +1,62 @@
+"""Utilities for selecting a bounded subset of response tokens for distillation.
+
+The response remains intact in ``input_ids`` and ``response_mask``.  Only
+``loss_mask`` is narrowed, so prefix-loss experiments do not change the model
+context or the teacher-scored trajectory.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+
+def build_response_loss_mask(
+    response_mask: torch.Tensor,
+    *,
+    max_prefix_tokens: Optional[int] = None,
+    suffix_tokens: int = 0,
+) -> torch.Tensor:
+    """Return a prefix, or prefix-plus-suffix, subset of valid response tokens.
+
+    ``response_mask`` may be one- or two-dimensional and is assumed to be
+    right-padded.  The returned tensor preserves its dtype and shape.  A suffix
+    is selected relative to each row's number of valid response tokens, not the
+    padded width.
+    """
+
+    if max_prefix_tokens is not None and max_prefix_tokens <= 0:
+        raise ValueError("max_prefix_tokens must be positive when set")
+    if suffix_tokens < 0:
+        raise ValueError("suffix_tokens must be non-negative")
+    if response_mask.ndim not in (1, 2):
+        raise ValueError(
+            "response_mask must be one- or two-dimensional, "
+            f"got shape={tuple(response_mask.shape)}"
+        )
+    if response_mask.is_nested:
+        raise ValueError("nested response masks are not supported")
+    if max_prefix_tokens is None and suffix_tokens == 0:
+        return response_mask
+
+    original_dtype = response_mask.dtype
+    valid = response_mask.bool()
+    squeeze = valid.ndim == 1
+    if squeeze:
+        valid = valid.unsqueeze(0)
+
+    width = valid.shape[-1]
+    positions = torch.arange(width, device=valid.device).unsqueeze(0)
+    selected = torch.zeros_like(valid)
+    if max_prefix_tokens is not None:
+        selected |= positions < max_prefix_tokens
+    if suffix_tokens:
+        valid_lengths = valid.sum(dim=-1, keepdim=True)
+        suffix_start = (valid_lengths - suffix_tokens).clamp_min(0)
+        selected |= (positions >= suffix_start) & (positions < valid_lengths)
+
+    selected &= valid
+    if squeeze:
+        selected = selected.squeeze(0)
+    return selected.to(dtype=original_dtype)
diff --git a/verl/trainer/distillation/virtual_teacher.py b/verl/trainer/distillation/virtual_teacher.py
new file mode 100644
index 0000000..c7b7c92
--- /dev/null
+++ b/verl/trainer/distillation/virtual_teacher.py
@@ -0,0 +1,268 @@
+"""Counterfactual teacher: split stop vs continue supervision.
+
+At every position the next-token distribution answers two questions:
+
+1. Stop now, or continue?  The stop event is the total mass on a small set of
+   end-of-sequence tokens.
+2. If continuing, which non-stop token?  That is the remaining mass,
+   renormalized.
+
+``teacher_stop`` copies the teacher's stop mass and keeps the current student's
+continue-conditional.  ``teacher_continue`` does the opposite.  Only the
+sampled token's mixed log-probability is returned, which is what K1 needs.
+"""
+
+from __future__ import annotations
+
+from typing import Iterable
+
+import torch
+
+VIRTUAL_TEACHER_NONE = "none"
+VIRTUAL_TEACHER_STOP = "teacher_stop"
+VIRTUAL_TEACHER_CONTINUE = "teacher_continue"
+VIRTUAL_TEACHER_MODES = (
+    VIRTUAL_TEACHER_NONE,
+    VIRTUAL_TEACHER_STOP,
+    VIRTUAL_TEACHER_CONTINUE,
+)
+DEFAULT_STOP_MASS_EPS = 1e-6
+
+
+def parse_stop_token_ids(raw: str | Iterable[int] | None) -> list[int]:
+    if raw is None:
+        return []
+    if isinstance(raw, str):
+        tokens = [int(piece.strip()) for piece in raw.split(",") if piece.strip()]
+    else:
+        tokens = [int(token) for token in raw]
+    if not tokens:
+        return []
+    # Preserve order while dropping duplicates so gather columns stay stable.
+    seen: set[int] = set()
+    unique: list[int] = []
+    for token in tokens:
+        if token in seen:
+            continue
+        seen.add(token)
+        unique.append(token)
+    return unique
+
+
+def log_stop_mass(stop_logprobs: torch.Tensor) -> torch.Tensor:
+    """Log-probability of emitting any configured stop token."""
+
+    return torch.logsumexp(stop_logprobs.float(), dim=-1)
+
+
+def log_continue_mass(
+    log_stop: torch.Tensor, eps: float = DEFAULT_STOP_MASS_EPS
+) -> torch.Tensor:
+    """Log-probability of not stopping, with a floor so the mix stays finite."""
+
+    stop_prob = log_stop.float().exp().clamp(max=1.0 - eps)
+    return torch.log1p(-stop_prob)
+
+
+def binary_stop_reverse_kl(
+    stop_logprobs_student: torch.Tensor,
+    stop_logprobs_teacher: torch.Tensor,
+) -> torch.Tensor:
+    """Exact KL(Bernoulli(student stop) || Bernoulli(teacher stop)).
+
+    Unlike sampled K1, this sums both stop and continue outcomes at every
+    prefix.  The only approximation is floating-point evaluation of the model
+    probabilities; no sampled event or loss clamp is involved.
+    """
+
+    student_log_stop = log_stop_mass(stop_logprobs_student)
+    teacher_log_stop = log_stop_mass(stop_logprobs_teacher)
+    student_stop = student_log_stop.exp().clamp(min=0.0, max=1.0)
+    teacher_stop = teacher_log_stop.exp().clamp(min=0.0, max=1.0)
+    student_continue = 1.0 - student_stop
+    # log1p preserves the O(p_stop) continue log-mass when p_stop is below
+    # float32 epsilon; log(1 - p_stop) would round its input to exactly one.
+    student_log_continue = torch.log1p(-student_stop)
+    teacher_log_continue = torch.log1p(-teacher_stop)
+
+    stop_term = torch.where(
+        student_stop > 0,
+        student_stop * (student_log_stop - teacher_log_stop),
+        torch.zeros_like(student_stop),
+    )
+    continue_term = torch.where(
+        student_continue > 0,
+        student_continue * (student_log_continue - teacher_log_continue),
+        torch.zeros_like(student_continue),
+    )
+    return stop_term + continue_term
+
+
+def gather_token_logprobs(
+    logits: torch.Tensor,
+    token_ids: list[int],
+    *,
+    vocab_chunk_size: int = 16384,
+) -> torch.Tensor:
+    """Log-softmax gather for a small fixed token set.
+
+    Compute the FP32 normalizer in vocabulary chunks instead of materializing
+    an FP32 copy of the full ``[tokens, vocab]`` tensor.
+    """
+
+    if not token_ids:
+        raise ValueError("token_ids must be non-empty")
+    if vocab_chunk_size <= 0:
+        raise ValueError("vocab_chunk_size must be positive")
+    vocab = logits.shape[-1]
+    for token_id in token_ids:
+        if token_id < 0 or token_id >= vocab:
+            raise ValueError(f"token id {token_id} is outside vocab size {vocab}")
+    index = torch.as_tensor(token_ids, device=logits.device, dtype=torch.long)
+    selected_logits = logits.index_select(-1, index).float()
+
+    logz = None
+    for logits_chunk in logits.split(vocab_chunk_size, dim=-1):
+        chunk_logz = torch.logsumexp(logits_chunk.float(), dim=-1)
+        logz = (
+            chunk_logz
+            if logz is None
+            else torch.logaddexp(logz, chunk_logz)
+        )
+    assert logz is not None
+    return selected_logits - logz.unsqueeze(-1)
+
+
+def mix_virtual_teacher_logprobs(
+    *,
+    mode: str,
+    sampled_logprob_teacher: torch.Tensor,
+    sampled_logprob_student: torch.Tensor,
+    stop_logprobs_teacher: torch.Tensor,
+    stop_logprobs_student: torch.Tensor,
+    sampled_is_stop: torch.Tensor,
+    eps: float = DEFAULT_STOP_MASS_EPS,
+) -> torch.Tensor:
+    """Return log q'(sampled token) under the requested counterfactual mix.
+
+    Student quantities are detached: the virtual teacher is a target, not a
+    second differentiable path through the current policy.
+    """
+
+    if mode not in (VIRTUAL_TEACHER_STOP, VIRTUAL_TEACHER_CONTINUE):
+        raise ValueError(f"unsupported virtual teacher mode {mode!r}")
+
+    teacher_token = sampled_logprob_teacher.float()
+    student_token = sampled_logprob_student.float().detach()
+    teacher_stop = log_stop_mass(stop_logprobs_teacher)
+    student_stop = log_stop_mass(stop_logprobs_student.detach())
+    teacher_continue = log_continue_mass(teacher_stop, eps=eps)
+    student_continue = log_continue_mass(student_stop, eps=eps)
+    is_stop = sampled_is_stop.bool()
+
+    if mode == VIRTUAL_TEACHER_STOP:
+        # Stop tokens keep the teacher's own stop-token probability. Continue
+        # tokens keep the student's continue-conditional, times teacher continue mass.
+        mixed = torch.where(
+            is_stop,
+            teacher_token,
+            teacher_continue + student_token - student_continue,
+        )
+    else:
+        mixed = torch.where(
+            is_stop,
+            student_token,
+            student_continue + teacher_token - teacher_continue,
+        )
+    return mixed.to(dtype=sampled_logprob_teacher.dtype)
+
+
+def decompose_sampled_full_teacher_k1(
+    *,
+    sampled_logprob_teacher: torch.Tensor,
+    sampled_logprob_student: torch.Tensor,
+    stop_logprobs_teacher: torch.Tensor,
+    stop_logprobs_student: torch.Tensor,
+    sampled_is_stop: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Split unclipped full-teacher sampled K1 into the two interventions.
+
+    Returns ``(full_teacher, teacher_stop, teacher_continue)`` with sign
+    ``log p_student(sample) - log p_target(sample)``.  The two counterfactual
+    terms are evaluated on exactly the same sampled tokens and satisfy
+
+    ``full_teacher == teacher_stop + teacher_continue``
+
+    up to floating-point roundoff.  Inputs are detached because this helper is
+    diagnostic; the training target remains defined by
+    :func:`mix_virtual_teacher_logprobs`.
+    """
+
+    student = sampled_logprob_student.detach().float()
+    teacher = sampled_logprob_teacher.detach().float()
+    teacher_stop_target = mix_virtual_teacher_logprobs(
+        mode=VIRTUAL_TEACHER_STOP,
+        sampled_logprob_teacher=teacher,
+        sampled_logprob_student=student,
+        stop_logprobs_teacher=stop_logprobs_teacher.detach(),
+        stop_logprobs_student=stop_logprobs_student.detach(),
+        sampled_is_stop=sampled_is_stop,
+    ).float()
+    teacher_continue_target = mix_virtual_teacher_logprobs(
+        mode=VIRTUAL_TEACHER_CONTINUE,
+        sampled_logprob_teacher=teacher,
+        sampled_logprob_student=student,
+        stop_logprobs_teacher=stop_logprobs_teacher.detach(),
+        stop_logprobs_student=stop_logprobs_student.detach(),
+        sampled_is_stop=sampled_is_stop,
+    ).float()
+    full_teacher_k1 = student - teacher
+    teacher_stop_k1 = student - teacher_stop_target
+    teacher_continue_k1 = student - teacher_continue_target
+    return full_teacher_k1, teacher_stop_k1, teacher_continue_k1
+
+
+def decompose_sampled_k1_by_event(
+    *,
+    sampled_logprob_target: torch.Tensor,
+    sampled_logprob_student: torch.Tensor,
+    stop_logprobs_target: torch.Tensor,
+    stop_logprobs_student: torch.Tensor,
+    sampled_is_stop: torch.Tensor,
+    eps: float = DEFAULT_STOP_MASS_EPS,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Split sampled K1 into binary-event and within-event terms.
+
+    For either a sampled stop or continue token, returns
+    ``(full, event, within_event)`` such that
+
+    ``full == event + within_event``
+
+    up to floating-point roundoff.  Unlike the two-counterfactual decomposition
+    above, this keeps the within-stop conditional term separate when one of
+    several configured stop tokens is sampled.
+    """
+
+    student_token = sampled_logprob_student.detach().float()
+    target_token = sampled_logprob_target.detach().float()
+    student_log_stop = log_stop_mass(stop_logprobs_student.detach())
+    target_log_stop = log_stop_mass(stop_logprobs_target.detach())
+    student_log_continue = log_continue_mass(student_log_stop, eps=eps)
+    target_log_continue = log_continue_mass(target_log_stop, eps=eps)
+    is_stop = sampled_is_stop.bool()
+    student_log_event = torch.where(
+        is_stop, student_log_stop, student_log_continue
+    )
+    target_log_event = torch.where(
+        is_stop, target_log_stop, target_log_continue
+    )
+
+    full_k1 = student_token - target_token
+    event_k1 = student_log_event - target_log_event
+    within_event_k1 = (
+        student_token
+        - student_log_event
+        - target_token
+        + target_log_event
+    )
+    return full_k1, event_k1, within_event_k1
