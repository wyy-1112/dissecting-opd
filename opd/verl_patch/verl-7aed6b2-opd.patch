index 0000000..9032a3f
--- /dev/null
+++ b/verl/trainer/ppo/replay.py
@@ -0,0 +1,1011 @@
+# Copyright 2025 Bytedance Ltd. and/or its affiliates
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Replay buffer and Bernoulli inclusion sampler for on-policy distillation.
+
+Rollouts are the dominant cost of an OPD step, so a trajectory that still
+carries a large teacher-student gap is worth training on more than once.  This
+module implements the data side of that: a fixed-depth FIFO buffer of prepared
+rollout batches, plus a sampler that draws a token-budgeted subset of it.
+
+The default depth is one, which makes this *current-batch* replay: a fresh
+batch is trained on in full, then re-drawn from a few times, then discarded and
+regenerated.  A response is therefore at most ``updates_per_cycle - 1``
+optimizer updates old when it is last trained on, whereas a depth-four FIFO
+would let a response survive well over a dozen updates.  Since the objective is
+defined against ``old_log_probs`` frozen when the batch was fresh, that age is
+exactly the state-distribution mismatch token-level importance sampling cannot
+fully correct, so keeping it small is what makes the reuse defensible.  Greater
+depth is left configurable as a later question: does a deeper buffer save more
+rollouts, and at what cost in staleness.
+
+Sampling is by *independent Bernoulli trials* with inclusion probability
+``q_i``.  That choice is deliberate: it makes the inclusion probability equal
+the nominal sampling probability, so ``1 / q_i`` is a valid Horvitz-Thompson
+weight.  A without-replacement scheme that fills the token budget exactly
+would induce inclusion probabilities that no longer match ``q_i``, and
+reweighting by ``1 / q_i`` would then be wrong.  The price is that the token
+budget is met in expectation rather than exactly; realized token counts are
+reported so the arms can be compared on tokens actually consumed.  Successive
+draws are independent, so a response may be picked by several replays in a row
+or by none.
+
+Priorities are scores scaled to meet the token budget, and two signals are
+available.
+
+Under a token budget the variance-optimal inclusion probability is
+``q_i \\propto \\sqrt{v_i / c_i}`` for influence ``v_i`` and cost
+``c_i \\propto D_i``, so each signal is a different estimate of ``v_i``.
+
+``length`` takes ``v_i \\propto D_i^a``, giving ``q_i \\propto D_i^\\gamma`` with
+``\\gamma = (a - 1) / 2``.  It is the only option for a selector that has to
+commit before a response exists, and ``\\gamma = 0`` makes every ``q_i`` equal to
+the budget fraction, which is the uniform control arm.
+
+``rms_k1`` uses the divergence that is already in the batch.  With
+``k_it = log pi_teacher - log pi_student`` on the student's own sampled actions,
+the magnitude multiplying the OPD gradient is
+``R_i = sqrt(mean_t k_it^2)``; signed averaging would instead shrink exactly the
+responses that disagree in both directions.  If token gradients are roughly
+uncorrelated then ``||G_i||^2 \\approx D_i R_i^2``, and substituting that gives
+``q_i \\propto R_i`` with the length factor cancelling.  Replay never needs the
+length proxy, because it draws from a batch that has already been generated and
+teacher-scored, so ``R_i`` costs no extra forward pass.  Measured offline
+against sketched influence, ``R_i`` recovers 59-86% of the headroom an oracle
+has over ``D^0.75``, and multiplying the two signals together is worse than
+``R_i`` alone: the length factor is already accounted for, so re-applying it
+over-concentrates the draw and collapses the effective sample size.
+"""
+
+from __future__ import annotations
+
+import copy
+from collections import deque
+from dataclasses import dataclass
+from typing import Optional
+
+import numpy as np
+import torch
+
+from verl.protocol import DataProto, pad_dataproto_to_divisor
+from verl.trainer.config.algorithm import ReplayConfig
+from verl.utils.replay_weights import REPLAY_WEIGHT_KEY
+
+__all__ = [
+    "REPLAY_COST_KEY",
+    "REPLAY_SCORE_KEY",
+    "FIFOReplayBuffer",
+    "ReplayConfig",
+    "ReplaySchedule",
+    "AnchorTerms",
+    "ReplayContinuationVerdict",
+    "ReplayProgressVerdict",
+    "anchor_progress",
+    "anchor_progress_contrast",
+    "anchor_reverse_kl_terms",
+    "evaluate_replay_continuation",
+    "evaluate_replay_progress",
+    "pad_replay_batch_for_data_parallel",
+    "pool_per_response",
+    "pooled_anchor_loss",
+    "pooled_anchor_rms",
+    "select_rows",
+    "solve_inclusion_probabilities",
+    "split_anchor_rows",
+]
+
+# Per-response loss-token count D_i, attached by the trainer before buffering so
+# that the sampler prices a response by the tokens it will actually train on.
+REPLAY_COST_KEY = "replay_cost"
+
+# Per-response priority score, attached by the trainer when the priority signal
+# is measured from the batch rather than derived from its lengths. Absent for the
+# length rule, which the sampler can compute from the costs alone.
+REPLAY_SCORE_KEY = "replay_score"
+
+# Meta-info describing the rows of one specific batch, used for FLOPs and
+# throughput accounting. A draw takes some rows from each of several batches, so
+# these entries are neither shared across the batches being concatenated nor
+# valid for the subset that results. They are dropped on the way into the buffer
+# and rebuilt for each draw by ``_rebuild_row_aligned_meta_info``.
+_ROW_ALIGNED_META_KEYS = ("global_token_num", "images_seqlens")
+
+
+def _rebuild_row_aligned_meta_info(batch: DataProto) -> None:
+    """Recompute the per-row meta-info entries for ``batch``.
+
+    Mirrors what the trainer does for a fresh batch, so a replayed batch reports
+    the tokens it actually contains rather than those of whichever batch it was
+    drawn from.
+
+    ``batch.meta_info`` is replaced rather than mutated because the callers
+    receive it by reference: ``DataProto.select_idxs`` and slicing both pass the
+    source batch's ``meta_info`` object straight through, so writing into it
+    would reach back into the buffer and leave a stored batch describing a
+    subset of its own rows.
+    """
+    images_seqlens: list[int] = []
+    for multi_modal_input in batch.non_tensor_batch.get("multi_modal_inputs", []):
+        if "image_grid_thw" in multi_modal_input:
+            images_seqlens.extend(multi_modal_input["images_seqlens"].tolist())
+    batch.meta_info = {
+        **batch.meta_info,
+        "global_token_num": torch.sum(batch.batch["attention_mask"], dim=-1).tolist(),
+        "images_seqlens": images_seqlens,
+    }
+
+
+@dataclass(frozen=True)
+class ReplayContinuationVerdict:
+    """Whether a batch is worth replaying again, and which gate said no."""
+
+    should_continue: bool
+    reason: str
+    learn_ratio: float
+    clip_fraction: float
+    ess_fraction: float
+
+    def as_metrics(self) -> dict[str, float]:
+        # ``reason`` is deliberately not a metric: the numeric gates plus the
+        # realized depth already say which one bound, and a string cannot be
+        # reduced across steps.
+        return {
+            "replay/adaptive_learn_ratio": self.learn_ratio,
+            "replay/adaptive_clip_fraction": self.clip_fraction,
+            "replay/adaptive_ess_fraction": self.ess_fraction,
+            "replay/adaptive_continue": float(self.should_continue),
+        }
+
+
+def evaluate_replay_continuation(
+    *,
+    learn_gap: float,
+    reference_learn_gap: float,
+    clip_fraction: float,
+    ess_fraction: float,
+    learn_gap_floor_fraction: float,
+    clip_fraction_ceiling: float,
+    ess_floor_fraction: float,
+) -> ReplayContinuationVerdict:
+    """Decide whether to draw from this batch again.
+
+    A trajectory carries two gaps that move in opposite directions as it is
+    reused. The teacher-to-current-student gap is how much is still worth
+    learning from it, and replay shrinks it. The current-student-to-generating-
+    student gap is how off-policy it has become, and replay only grows it. A
+    fixed replay depth ignores both; this continues only while there is
+    something left to learn *and* the trajectory is not yet too old.
+
+    ``learn_gap`` is compared against the first replay draw of the same batch
+    rather than against its fresh update. Both are then priority-selected draws
+    from the same buffer, so the ratio measures what reuse consumed instead of
+    also picking up the selection effect: a priority rule that favours
+    high-divergence responses would otherwise look like a batch that never
+    exhausts.
+
+    Staleness is read from the PPO ratio's clip fraction and effective sample
+    size. Neither is a full defence -- clipping corrects the action mismatch on
+    observed tokens only, never the state-distribution mismatch of a stale
+    prefix -- so they serve to stop replay in time rather than to make old data
+    safe indefinitely.
+
+    Args:
+        learn_gap: RMS K1 against the teacher on this draw.
+        reference_learn_gap: The same quantity on the cycle's first replay draw.
+        clip_fraction: Share of tokens whose PPO ratio was clipped.
+        ess_fraction: Effective sample size of the ratio, as a share of tokens.
+        learn_gap_floor_fraction: Stop once ``learn_gap`` falls below this
+            fraction of the reference.
+        clip_fraction_ceiling: Stop once the clip fraction exceeds this.
+        ess_floor_fraction: Stop once the effective sample size falls below this.
+
+    Returns:
+        The verdict, with the three measured quantities for logging.
+    """
+    ratio = learn_gap / reference_learn_gap if reference_learn_gap > 0 else 1.0
+    if ratio < learn_gap_floor_fraction:
+        reason = "learn_gap_exhausted"
+    elif clip_fraction > clip_fraction_ceiling:
+        reason = "off_policy_clipping"
+    elif ess_fraction < ess_floor_fraction:
+        reason = "off_policy_ess"
+    else:
+        reason = "continue"
+    return ReplayContinuationVerdict(
+        should_continue=reason == "continue",
+        reason=reason,
+        learn_ratio=ratio,
+        clip_fraction=clip_fraction,
+        ess_fraction=ess_fraction,
+    )
+
+
+@dataclass(frozen=True)
+class ReplayProgressVerdict:
+    """Whether one more replay draw still beats spending the seconds on rollouts."""
+
+    should_continue: bool
+    reason: str
+    raw_progress_lcb: float
+    raw_contrast_lcb: float
+    clipped_contrast_lcb: float
+    cost_ratio: float
+    improves_anchor: bool
+    beats_fresh: bool
+    robust_to_clipping: bool
+    anchor_ess_ok: bool
+    actor_clip_ok: bool
+    actor_ess_ok: bool
+
+    def as_metrics(self) -> dict[str, float]:
+        # Every condition is reported, not only whichever bound first, so a cycle
+        # that stopped can be attributed without re-deriving the others.
+        return {
+            # The three quantities the rule thresholds at zero, so their
+            # distribution across cycles says how close the calls were.
+            "replay/progress_raw_progress_lcb": self.raw_progress_lcb,
+            "replay/progress_raw_contrast_lcb": self.raw_contrast_lcb,
+            "replay/progress_clipped_contrast_lcb": self.clipped_contrast_lcb,
+            "replay/progress_cost_ratio": self.cost_ratio,
+            "replay/progress_improves_anchor": float(self.improves_anchor),
+            "replay/progress_beats_fresh": float(self.beats_fresh),
+            "replay/progress_robust_to_clipping": float(self.robust_to_clipping),
+            "replay/progress_anchor_ess_ok": float(self.anchor_ess_ok),
+            "replay/progress_actor_clip_ok": float(self.actor_clip_ok),
+            "replay/progress_actor_ess_ok": float(self.actor_ess_ok),
+            "replay/progress_continue": float(self.should_continue),
+        }
+
+
+@dataclass(frozen=True)
+class AnchorTerms:
+    """One scoring of the anchor, estimated with and without the weight cap.
+
+    The capped and uncapped estimates are both kept because they answer
+    different questions. Capping bounds the variance an update is trained
+    against, which is why the objective caps its ratios, but the monitoring
+    estimate is trying to measure something and has no reason to inherit that
+    cap. When the two disagree about whether replay is still worth it, the
+    verdict is being decided by the tail of the importance weights rather than
+    by the model, and the honest response is to stop rather than to pick
+    whichever estimate is more convenient.
+    """
+
+    raw_numerators: np.ndarray
+    clipped_numerators: np.ndarray
+    tokens: np.ndarray
+    raw_ess_fraction: float
+    clipped_token_fraction: float
+    removed_mass_fraction: float
+    rms: float
+
+    @property
+    def raw_loss(self) -> float:
+        return pooled_anchor_loss(self.raw_numerators, self.tokens)
+
+    @property
+    def clipped_loss(self) -> float:
+        return pooled_anchor_loss(self.clipped_numerators, self.tokens)
+
+    def as_metrics(self, prefix: str) -> dict[str, float]:
+        return {
+            f"{prefix}_loss_raw": self.raw_loss,
+            f"{prefix}_loss_clipped": self.clipped_loss,
+            # Not what the gate stops on, but what draws are prioritized by, so
+            # watching it beside L_A is how the two roles get checked.
+            f"{prefix}_rms": self.rms,
+            # The effective sample size is taken over uncapped weights: capping
+            # is exactly what hides weight concentration, so a capped figure
+            # would read healthy at the moment it matters.
+            f"{prefix}_ess_raw": self.raw_ess_fraction,
+            f"{prefix}_clipped_token_fraction": self.clipped_token_fraction,
+            # How much weight the cap removed, which says more about how badly
+            # the estimate is affected than how many tokens it touched: one
+            # enormous weight matters more than many slightly-over ones.
+            f"{prefix}_removed_mass_fraction": self.removed_mass_fraction,
+        }
+
+
+def anchor_reverse_kl_terms(
+    student_log_probs: torch.Tensor,
+    teacher_log_probs: torch.Tensor,
+    rollout_log_probs: torch.Tensor,
+    loss_mask: torch.Tensor,
+    *,
+    weight_clamp: float,
+    rms_clamp: float,
+    numerical_log_clamp: float = 50.0,
+) -> AnchorTerms:
+    """Per-response numerators of the importance-corrected reverse KL, and its cost.
+
+    The anchor histories are fixed, so the quantity that says how much teacher
+    delta is left on them is the reverse KL at the current parameters,
+
+        L_A(theta) = (1 / sum_i D_i) * sum_it w_it * (log pi_theta - log pi_T),
+        w_it = exp(log pi_theta - log pi_rollout),
+
+    with the actions drawn from the rollout policy and reweighted onto
+    ``pi_theta``. RMS K1 is a discrepancy surrogate, not this objective: it is
+    the right thing to prioritize draws by, because it tracks the gradient
+    magnitude, but it is the wrong thing to stop on because it never
+    distinguishes a student that has reached the teacher from one that has shot
+    past it. The signed gap alone has the opposite defect -- uncorrected, it
+    keeps falling through zero as the student overshoots on these fixed actions,
+    and replaying one batch a dozen times is exactly how overshoot happens. The
+    importance weight is what makes the signed gap bottom out at zero instead.
+
+    Sign convention, which this file and the loss metrics disagree on and which
+    matters here in a way it never did for RMS: ``log pi_theta - log pi_T`` is
+    what ``distillation/k1_mean`` reports, and its expectation at
+    ``theta = theta_rollout`` is ``+KL(pi_rollout || pi_T) >= 0``. The ``k_it``
+    of this module's header is that quantity negated.
+
+    Teacher log probabilities come from the batch, computed when it was fresh, so
+    no replay draw and no measurement sends a token back to the teacher. The
+    anchor's own generation and teacher scoring were paid once, with the batch.
+
+    Args:
+        student_log_probs: Current parameters, from a forward over the anchor.
+        teacher_log_probs: Cached with the batch.
+        rollout_log_probs: The policy the anchor's actions were drawn from.
+        loss_mask: Tokens the objective covers.
+        weight_clamp: Ceiling on ``w_it`` for the capped estimate. Reported
+            alongside the uncapped one rather than replacing it.
+        rms_clamp: Bound on ``|k_it|`` for the RMS diagnostic.
+        numerical_log_clamp: Bound on the log ratio before exponentiating, so
+            the uncapped estimate cannot overflow to infinity and poison the
+            arithmetic. At 50 this admits weights up to ``e^50``, far past any
+            weight that leaves the effective sample size usable, so it is a
+            floating-point guard and not a statistical cap.
+
+    Returns:
+        The scoring, per response for the numerators and token counts so a
+        standard error can be clustered by response rather than treating tokens
+        inside one response as independent.
+    """
+    if weight_clamp <= 0.0:
+        raise ValueError(f"weight_clamp must be > 0, got {weight_clamp}")
+    mask = loss_mask.to(dtype=torch.float64)
+    gap = (student_log_probs - teacher_log_probs).to(torch.float64)
+    log_ratio = (student_log_probs - rollout_log_probs).to(torch.float64)
+    raw_weight = torch.exp(log_ratio.clamp(-numerical_log_clamp, numerical_log_clamp))
+    clipped_weight = raw_weight.clamp(max=weight_clamp)
+
+    token_count = float(mask.sum().item())
+    if token_count <= 0.0:
+        raise ValueError("anchor has no loss tokens")
+    masked_raw = raw_weight * mask
+    weight_sum = float(masked_raw.sum().item())
+    clipped_token_fraction = float(((raw_weight > weight_clamp).to(mask.dtype) * mask).sum().item()) / token_count
+    excess = ((raw_weight - weight_clamp).clamp(min=0.0) * mask).sum().item()
+    removed_mass_fraction = float(excess) / weight_sum if weight_sum > 0.0 else 0.0
+    # ESS = (sum w)^2 / sum w^2, as a share of the tokens it is taken over.
+    square_sum = float((masked_raw * raw_weight).sum().item())
+    raw_ess_fraction = (weight_sum * weight_sum / square_sum / token_count) if square_sum > 0.0 else 0.0
+
+    to_numpy = lambda values: values.flatten(1).sum(-1).detach().cpu().numpy().astype(np.float64)
+    return AnchorTerms(
+        raw_numerators=to_numpy(raw_weight * gap * mask),
+        clipped_numerators=to_numpy(clipped_weight * gap * mask),
+        tokens=to_numpy(mask),
+        raw_ess_fraction=raw_ess_fraction,
+        clipped_token_fraction=clipped_token_fraction,
+        removed_mass_fraction=removed_mass_fraction,
+        rms=pooled_anchor_rms(student_log_probs, teacher_log_probs, loss_mask, clamp=rms_clamp),
+    )
+
+
+def pooled_anchor_loss(numerators: np.ndarray, tokens: np.ndarray) -> float:
+    """Token-pooled ``L_A``, matching the token-mean the objective is normalized by."""
+    total = float(np.asarray(tokens, dtype=np.float64).sum())
+    if total <= 0.0:
+        raise ValueError("anchor has no loss tokens")
+    return float(np.asarray(numerators, dtype=np.float64).sum() / total)
+
+
+def pool_per_response(values: np.ndarray, tokens: np.ndarray) -> tuple[float, float]:
+    """Token-pool per-response contributions and take a response-clustered error.
+
+    The denominator ``sum_i D_i`` is identical for every scoring in a cycle --
+    the anchor rows and their loss mask never change -- so a pooled statistic is
+    a sum of per-response contributions over a constant, and its variance needs
+    no ratio-estimator correction. Clustering is by response because tokens
+    within one response share a prefix and are nowhere near independent;
+    treating them as independent would shrink the error by roughly the square
+    root of the response length.
+
+    Returns:
+        ``(pooled, stderr)``, the error zero for a single response.
+    """
+    values = np.asarray(values, dtype=np.float64).reshape(-1)
+    tokens = np.asarray(tokens, dtype=np.float64).reshape(-1)
+    if values.shape != tokens.shape:
+        raise ValueError(f"anchor terms must align, got {values.shape} and {tokens.shape}")
+    if values.size == 0:
+        raise ValueError("anchor must hold at least one response")
+    total_tokens = float(tokens.sum())
+    if total_tokens <= 0.0:
+        raise ValueError("anchor has no loss tokens")
+    pooled = float(values.sum() / total_tokens)
+    if values.size < 2:
+        return pooled, 0.0
+    return pooled, float(np.sqrt(values.size) * values.std(ddof=1) / total_tokens)
+
+
+def anchor_progress(
+    before: np.ndarray, after: np.ndarray, tokens: np.ndarray
+) -> tuple[float, float]:
+    """``m_k``, the anchor loss one update removed, with its clustered error.
+
+    This is the absolute question, and the cost comparison cannot stand in for
+    it. A contrast against a fresh update that itself made the anchor worse goes
+    positive while replay is also making it worse, just less quickly: at
+    ``m_f = -0.02`` and ``m_k = -0.001`` with a cost ratio of 0.1 the contrast
+    is ``+0.001``, which reads as "keep replaying" on a draw that damaged the
+    model. Requiring absolute progress as well is what rules that out.
+    """
+    before = np.asarray(before, dtype=np.float64).reshape(-1)
+    after = np.asarray(after, dtype=np.float64).reshape(-1)
+    if before.shape != after.shape:
+        raise ValueError(f"anchor terms must align, got {before.shape} and {after.shape}")
+    return pool_per_response(before - after, tokens)
+
+
+def anchor_progress_contrast(
+    *,
+    replay_before: np.ndarray,
+    replay_after: np.ndarray,
+    fresh_before: np.ndarray,
+    fresh_after: np.ndarray,
+    tokens: np.ndarray,
+    cost_ratio: float,
+) -> tuple[float, float]:
+    """The paired contrast ``d_k = m_k - (C_r / C_f) m_f`` and its clustered error.
+
+    Testing ``m_k / C_r > m_f / C_f`` by comparing two point estimates says
+    nothing about whether replay is *statistically* the better buy. Rearranged
+    into a single contrast, both terms are measured on the same anchor responses
+    and the correlation between them enters the error instead of being ignored,
+    so a lower confidence bound above zero is a real statement.
+
+    This is the efficiency question only. It has to be paired with
+    ``anchor_progress`` for the absolute one.
+
+    Args:
+        replay_before: Per-response numerators before the replay draw.
+        replay_after: The same after it.
+        fresh_before: Per-response numerators before this cycle's fresh update.
+        fresh_after: The same after it.
+        tokens: Per-response loss-token counts, fixed across the cycle.
+        cost_ratio: ``C_r / C_f``, the seconds a replay draw costs over the
+            seconds one more fresh batch would.
+
+    Returns:
+        ``(contrast, stderr)``, in the units of ``L_A``.
+    """
+    arrays = [
+        np.asarray(a, dtype=np.float64).reshape(-1)
+        for a in (replay_before, replay_after, fresh_before, fresh_after)
+    ]
+    if len({a.shape for a in arrays}) != 1:
+        raise ValueError(f"anchor terms must align, got shapes {[a.shape for a in arrays]}")
+    replay_before, replay_after, fresh_before, fresh_after = arrays
+    if cost_ratio <= 0.0:
+        raise ValueError(f"cost_ratio must be > 0, got {cost_ratio}")
+    per_response = (replay_before - replay_after) - cost_ratio * (fresh_before - fresh_after)
+    return pool_per_response(per_response, tokens)
+
+
+def evaluate_replay_progress(
+    *,
+    raw_progress: tuple[float, float],
+    raw_contrast: tuple[float, float],
+    clipped_contrast: tuple[float, float],
+    cost_ratio: float,
+    noise_z: float,
+    anchor_ess_fraction: float,
+    actor_clip_fraction: float,
+    actor_ess_fraction: float,
+    clip_fraction_ceiling: float,
+    ess_floor_fraction: float,
+) -> ReplayProgressVerdict:
+    """Decide whether to draw again, on marginal return per unit cost.
+
+    ``learn_gap_floor_fraction`` asks how much teacher gap is left, which is a
+    stock where the decision is a flow: a pair whose gap is structurally large
+    reads "plenty left to learn" forever even when each draw buys nothing, and a
+    pair whose gap collapses reads "done" even while draws are still cheap enough
+    to be worth taking. Nothing here refers to the absolute gap.
+
+    Three separate things have to hold, and none of them substitutes for
+    another.
+
+    The draw has to have *helped*: ``m_k`` above zero. A cost comparison alone
+    does not establish this, because a contrast against a fresh update that
+    itself hurt the anchor goes positive on a draw that also hurt it, only more
+    slowly.
+
+    The draw has to have been *worth its seconds*: ``d_k`` above zero. Replay
+    skips generation and teacher scoring, so its bar is a fraction of the fresh
+    update's gain, and this is the only place the cost ratio enters.
+
+    And the verdict has to survive the *choice of estimator*. Both are computed,
+    uncapped and with the weight cap, and both have to agree. A disagreement
+    means the answer is coming from the tail of the importance weights rather
+    than from the model, which is not a basis for spending more compute.
+
+    Progress is measured on responses held out of every update in the cycle, so
+    it is a generalization gain rather than a training-loss drop, and the fresh
+    update's gain comes from the same held-out responses. Comparing a training
+    number against a held-out one would flatter replay, which trains on far
+    fewer distinct responses.
+
+    The staleness gates stay, unchanged and independent. ``L_A`` is measured on
+    the state distribution the batch was sampled from, so it can improve while
+    the on-policy objective does not -- the model gets better on states it has
+    rather than states it would now visit. No amount of measured progress
+    licenses an arbitrarily stale draw.
+
+    Args:
+        raw_progress: ``(m_k, stderr)`` from the uncapped estimate.
+        raw_contrast: ``(d_k, stderr)`` from the uncapped estimate.
+        clipped_contrast: ``(d_k, stderr)`` from the capped estimate.
+        cost_ratio: ``C_r / C_f``, measured in this run rather than assumed;
+            holding the anchor out changed the fresh batch's size and added a
+            forward to every update, so any previously profiled ratio is stale.
+        noise_z: Standard errors each bound must clear.
+        anchor_ess_fraction: Effective sample size of the anchor's importance
+            weights, over uncapped weights. Capping is what conceals weight
+            concentration, so a capped figure reads healthy exactly when it
+            matters.
+        actor_clip_fraction: Share of tokens the actor update clipped.
+        actor_ess_fraction: Effective sample size of the actor's PPO ratio.
+        clip_fraction_ceiling: Stop once the actor's clip fraction exceeds this.
+        ess_floor_fraction: Stop once either effective sample size falls below
+            this.
+
+    Returns:
+        The verdict, with every condition evaluated rather than only the first
+        one to bind.
+    """
+    if cost_ratio <= 0.0:
+        raise ValueError(f"cost_ratio must be > 0, got {cost_ratio}")
+    bound = lambda pair: pair[0] - noise_z * pair[1]
+    raw_progress_lcb = bound(raw_progress)
+    raw_contrast_lcb = bound(raw_contrast)
+    clipped_contrast_lcb = bound(clipped_contrast)
+
+    improves_anchor = bool(raw_progress_lcb > 0.0)
+    beats_fresh = bool(raw_contrast_lcb > 0.0)
+    robust_to_clipping = bool(clipped_contrast_lcb > 0.0)
+    anchor_ess_ok = bool(anchor_ess_fraction >= ess_floor_fraction)
+    actor_clip_ok = bool(actor_clip_fraction <= clip_fraction_ceiling)
+    actor_ess_ok = bool(actor_ess_fraction >= ess_floor_fraction)
+
+    if not improves_anchor:
+        reason = "no_absolute_progress"
+    elif not beats_fresh:
+        reason = "fresh_is_cheaper"
+    elif not robust_to_clipping:
+        reason = "importance_weight_tails"
+    elif not anchor_ess_ok:
+        reason = "anchor_ess_collapsed"
+    elif not actor_clip_ok:
+        reason = "off_policy_clipping"
+    elif not actor_ess_ok:
+        reason = "off_policy_ess"
+    else:
+        reason = "continue"
+    return ReplayProgressVerdict(
+        should_continue=reason == "continue",
+        reason=reason,
+        raw_progress_lcb=raw_progress_lcb,
+        raw_contrast_lcb=raw_contrast_lcb,
+        clipped_contrast_lcb=clipped_contrast_lcb,
+        cost_ratio=cost_ratio,
+        improves_anchor=improves_anchor,
+        beats_fresh=beats_fresh,
+        robust_to_clipping=robust_to_clipping,
+        anchor_ess_ok=anchor_ess_ok,
+        actor_clip_ok=actor_clip_ok,
+        actor_ess_ok=actor_ess_ok,
+    )
+
+
+def select_rows(batch: DataProto, rows: np.ndarray) -> DataProto:
+    """Take ``rows`` of ``batch`` with the per-row meta-info rebuilt.
+
+    ``DataProto.select_idxs`` passes ``meta_info`` through by reference, so a
+    subset would otherwise keep the token counts of the batch it came from and
+    report them to the throughput and FLOPs metrics.
+    """
+    selected = batch.select_idxs(rows)
+    _rebuild_row_aligned_meta_info(selected)
+    return selected
+
+
+def pooled_anchor_rms(
+    student_log_probs: torch.Tensor,
+    teacher_log_probs: torch.Tensor,
+    loss_mask: torch.Tensor,
+    *,
+    clamp: float,
+) -> float:
+    """Token-pooled RMS K1 on the anchor, kept as a diagnostic beside ``L_A``.
+
+    Pooled over ``sum_i D_i`` rather than averaged across per-response RMS
+    values, so it is normalized the way the token-mean objective is; averaging
+    32 per-response RMS numbers would weight a short response as heavily as a
+    long one and stop being comparable to anything the loss reports.
+
+    This is not what the gate stops on -- RMS cannot tell a student that reached
+    the teacher from one that overshot -- but it is what draws are prioritized
+    by, so watching it next to ``L_A`` is how the two roles get checked against
+    each other.
+    """
+    mask = loss_mask.to(dtype=student_log_probs.dtype)
+    difference = (teacher_log_probs - student_log_probs).clamp(-clamp, clamp)
+    total = float(mask.sum().item())
+    if total <= 0.0:
+        raise ValueError("anchor has no loss tokens")
+    return float(torch.sqrt((difference * difference * mask).sum() / mask.sum()).item())
+
+
+def split_anchor_rows(
+    num_responses: int,
+    anchor_responses: int,
+    dp_size: int,
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Split a batch's rows into a training part and a held-out anchor.
+
+    Both parts are rounded down to a multiple of ``dp_size`` so each can be run
+    as one even data-parallel pass; the remainder joins the training part, which
+    is the one whose size the update budget is stated in.
+
+    The draw is random rather than positional because the dataloader emits rows
+    in prompt order, so taking a contiguous slice would make the anchor a biased
+    sample of whichever prompts happen to sort together.
+
+    Args:
+        num_responses: Rows in the prepared batch.
+        anchor_responses: Rows requested for the anchor.
+        dp_size: Data-parallel world size the parts have to divide by.
+        rng: Source of the permutation.
+
+    Returns:
+        ``(train_idx, anchor_idx)``, both sorted so the batch keeps its order.
+    """
+    if dp_size < 1:
+        raise ValueError(f"dp_size must be >= 1, got {dp_size}")
+    if anchor_responses < 0:
+        raise ValueError(f"anchor_responses must be >= 0, got {anchor_responses}")
+    anchor_size = (anchor_responses // dp_size) * dp_size
+    if anchor_size == 0:
+        return np.arange(num_responses), np.empty(0, dtype=np.int64)
+    train_size = ((num_responses - anchor_size) // dp_size) * dp_size
+    if train_size < dp_size:
+        raise ValueError(
+            f"anchor of {anchor_size} rows leaves {num_responses - anchor_size} for training, "
+            f"which is under one data-parallel pass of {dp_size}"
+        )
+    perm = rng.permutation(num_responses)
+    anchor_idx = np.sort(perm[:anchor_size])
+    train_idx = np.sort(perm[anchor_size : anchor_size + train_size])
+    return train_idx, anchor_idx
+
+
+def solve_inclusion_probabilities(
+    costs: np.ndarray,
+    budget: float,
+    *,
+    priority_exponent: float = 0.0,
+    min_inclusion_prob: float,
+    priority_scores: Optional[np.ndarray] = None,
+    max_iter: int = 200,
+) -> np.ndarray:
+    """Return Bernoulli inclusion probabilities meeting ``budget`` in expectation.
+
+    ``q_i = clip(lambda * s_i, q_min, 1)``, with ``lambda`` solved so that
+    ``sum_i q_i * D_i == budget``.  Both clips are what make ``lambda`` need
+    solving at all; without them it would be a closed form.  ``sum_i q_i D_i``
+    is non-decreasing in ``lambda``, so the solve is a bisection.
+
+    The scores ``s_i`` are either supplied directly or, by default, derived from
+    the costs as ``D_i^gamma``.  Only their ratios matter, since ``lambda``
+    absorbs any overall scale.  At ``gamma = 0`` every ``q_i`` is the same and
+    equals ``budget / sum_j D_j``, which is the uniform arm.
+
+    Args:
+        costs: Per-response token counts ``D_i``, all positive.
+        budget: Target number of training tokens for this update.
+        priority_exponent: ``gamma`` for the default length scores; ignored when
+            ``priority_scores`` is given.
+        min_inclusion_prob: ``q_min``, the floor that bounds ``1 / q_i``.  Without
+            it a very short response could take an arbitrarily large weight.
+        priority_scores: Explicit non-negative scores, one per response, used in
+            place of the length scores.  Entries at or below zero are raised to
+            the smallest positive score so that a response with no measured
+            divergence still falls back to the floor rather than becoming
+            unselectable, which would bias the estimator.
+
+    Returns:
+        ``q`` of the same shape as ``costs``, each entry in ``[q_min, 1]``.
+    """
+    costs = np.asarray(costs, dtype=np.float64)
+    if costs.ndim != 1 or costs.size == 0:
+        raise ValueError(f"costs must be a non-empty 1-D array, got shape {costs.shape}")
+    if not np.all(costs > 0):
+        raise ValueError("costs must be positive; a response with no loss tokens cannot be priced")
+    if budget <= 0:
+        raise ValueError(f"budget must be positive, got {budget}")
+    if not 0.0 < min_inclusion_prob <= 1.0:
+        raise ValueError(f"min_inclusion_prob must be in (0, 1], got {min_inclusion_prob}")
+
+    n = costs.size
+    total = float(costs.sum())
+    if budget >= total:
+        # The budget covers the whole buffer, so nothing is excluded and the
+        # weights are all one.
+        return np.ones(n, dtype=np.float64)
+    if budget <= min_inclusion_prob * total:
+        # The floor alone already spends the budget, so no response can be given
+        # more than the floor and the draw is uniform at ``q_min``.
+        return np.full(n, min_inclusion_prob, dtype=np.float64)
+
+    if priority_scores is None:
+        priority = np.power(costs, priority_exponent)
+    else:
+        priority = np.asarray(priority_scores, dtype=np.float64).reshape(-1)
+        if priority.size != n:
+            raise ValueError(f"expected {n} priority scores, got {priority.size}")
+        if not np.all(np.isfinite(priority)):
+            raise ValueError("priority scores must be finite")
+        if not np.any(priority > 0):
+            raise ValueError("priority scores must contain at least one positive entry")
+        floor = float(priority[priority > 0].min())
+        priority = np.where(priority > 0, priority, floor)
+
+    def expected_tokens(scale: float) -> float:
+        return float(np.clip(scale * priority, min_inclusion_prob, 1.0) @ costs)
+
+    # At ``scale = 1 / min(priority)`` every ``q_i`` saturates at one, so expected
+    # tokens equal ``total > budget``: a valid upper bracket.
+    lo, hi = 0.0, 1.0 / float(priority.min())
+    for _ in range(max_iter):
+        mid = 0.5 * (lo + hi)
+        if expected_tokens(mid) < budget:
+            lo = mid
+        else:
+            hi = mid
+    return np.clip(0.5 * (lo + hi) * priority, min_inclusion_prob, 1.0)
+
+
+def pad_replay_batch_for_data_parallel(batch: DataProto, dp_size: int) -> tuple[DataProto, int]:
+    """Pad a drawn batch to a multiple of ``dp_size`` using zero-weight rows.
+
+    A Bernoulli draw has a variable response count, but the batch still has to
+    split evenly across data-parallel ranks.  Padding repeats real responses, so
+    their replay weight is set to zero: they then contribute to neither the loss
+    nor its normalizer and the update stays exactly the one the draw defines.
+    """
+    padded, pad_size = pad_dataproto_to_divisor(batch, dp_size)
+    if pad_size > 0:
+        weights = padded.batch[REPLAY_WEIGHT_KEY].clone()
+        # ``pad_dataproto_to_divisor`` appends copies taken from the front, so
+        # the padding is the tail and the originals must keep their weight.
+        weights[-pad_size:] = 0.0
+        padded.batch[REPLAY_WEIGHT_KEY] = weights
+        # The padded rows are still forwarded and back-propagated, so they belong
+        # in the token counts the throughput and FLOPs metrics are built from.
+        _rebuild_row_aligned_meta_info(padded)
+    return padded, pad_size
+
+
+class ReplaySchedule:
+    """Decide how many replay updates follow each fresh rollout.
+
+    A cycle is one fresh update followed by ``updates_per_cycle - 1`` replay
+    updates.  Replay only starts once the buffer holds ``buffer_batches``
+    batches, so no draw ever comes from a partially filled buffer; at the
+    default depth of one the fresh batch just pushed *is* the full buffer and
+    every cycle from the first is complete.
+    """
+
+    def __init__(self, buffer_batches: int, updates_per_cycle: int):
+        self.buffer_batches = buffer_batches
+        self.updates_per_cycle = updates_per_cycle
+
+    def replay_updates_after(self, num_fresh_updates_done: int) -> int:
+        """Replay updates to run after the ``num_fresh_updates_done``-th fresh update."""
+        if num_fresh_updates_done < self.buffer_batches:
+            return 0
+        return self.updates_per_cycle - 1
+
+
+class FIFOReplayBuffer:
+    """Fixed-depth FIFO buffer of prepared rollout batches.
+
+    Batches are stored exactly as the trainer prepared them, which keeps
+    ``old_log_probs`` frozen at the value computed when the batch was fresh.
+    That staleness is intentional: it is the proximal anchor the decoupled PPO
+    objective is defined against, and its decay across replays is one of the
+    quantities the experiment measures.  Teacher log probabilities are stored
+    too, so a replayed response costs no teacher tokens.
+
+    At the default capacity of one, pushing the next fresh batch evicts the
+    previous one, which is how a batch gets discarded after its cycle without
+    any explicit clearing step.
+    """
+
+    def __init__(self, capacity: int):
+        if capacity < 1:
+            raise ValueError(f"capacity must be >= 1, got {capacity}")
+        self.capacity = capacity
+        self._batches: deque[DataProto] = deque()
+        self._costs: deque[np.ndarray] = deque()
+        self._scores: deque[Optional[np.ndarray]] = deque()
+        self._push_count = 0
+
+    def __len__(self) -> int:
+        return len(self._batches)
+
+    @property
+    def is_full(self) -> bool:
+        return len(self._batches) >= self.capacity
+
+    @property
+    def num_responses(self) -> int:
+        return int(sum(c.size for c in self._costs))
+
+    @property
+    def total_tokens(self) -> float:
+        return float(sum(c.sum() for c in self._costs))
+
+    @property
+    def nbytes(self) -> int:
+        """Host memory held by the buffer.
+
+        Buffered batches keep full-width padded rollouts on the driver, so this
+        is worth reporting: it grows with capacity and response length and is
+        the driver's largest allocation.
+        """
+        return int(sum(t.numel() * t.element_size() for b in self._batches for t in b.batch.values()))
+
+    def costs(self) -> np.ndarray:
+        """Pooled per-response loss-token counts, in buffer order."""
+        if not self._costs:
+            return np.empty(0, dtype=np.float64)
+        return np.concatenate(list(self._costs))
+
+    def scores(self) -> Optional[np.ndarray]:
+        """Pooled per-response priority scores, or ``None`` if any batch lacks them.
+
+        A partially scored buffer would mix two priority rules in one draw, so it
+        is treated as unscored rather than silently filled in.
+        """
+        if not self._scores or any(score is None for score in self._scores):
+            return None
+        return np.concatenate(list(self._scores))
+
+    def push(self, batch: DataProto) -> None:
+        """Add a prepared batch, evicting the oldest once at capacity.
+
+        The batch is stored as an independent CPU copy: the caller keeps using
+        its own object for the fresh update, logging, and metrics, and a shared
+        reference would let those mutate buffered data.
+        """
+        if REPLAY_COST_KEY not in batch.batch:
+            raise KeyError(f"batch must carry per-response costs under {REPLAY_COST_KEY!r} before buffering")
+        costs = batch.batch[REPLAY_COST_KEY].detach().cpu().numpy().astype(np.float64).reshape(-1)
+        if costs.size != len(batch):
+            raise ValueError(f"expected one cost per response, got {costs.size} for {len(batch)} responses")
+
+        scores: Optional[np.ndarray] = None
+        if REPLAY_SCORE_KEY in batch.batch:
+            scores = batch.batch[REPLAY_SCORE_KEY].detach().cpu().numpy().astype(np.float64).reshape(-1)
+            if scores.size != len(batch):
+                raise ValueError(f"expected one score per response, got {scores.size} for {len(batch)} responses")
+
+        meta_info = {k: v for k, v in batch.meta_info.items() if k not in _ROW_ALIGNED_META_KEYS}
+        stored = DataProto(
+            batch=batch.batch.detach().clone().cpu(),
+            non_tensor_batch=copy.deepcopy(batch.non_tensor_batch),
+            meta_info=copy.deepcopy(meta_info),
+        )
+        self._batches.append(stored)
+        self._costs.append(costs)
+        self._scores.append(scores)
+        self._push_count += 1
+        while len(self._batches) > self.capacity:
+            self._batches.popleft()
+            self._costs.popleft()
+            self._scores.popleft()
+
+    def sample(
+        self,
+        budget: float,
+        *,
+        priority_exponent: float,
+        min_inclusion_prob: float,
+        rng: np.random.Generator,
+    ) -> tuple[Optional[DataProto], dict]:
+        """Draw a token-budgeted subset and attach its ``1 / q_i`` weights.
+
+        Returns the selected batch (``None`` if the buffer is empty) and
+        diagnostics describing the draw.
+        """
+        if not self._batches:
+            return None, {}
+
+        costs = self.costs()
+        scores = self.scores()
+        q = solve_inclusion_probabilities(
+            costs,
+            budget,
+            priority_exponent=priority_exponent,
+            min_inclusion_prob=min_inclusion_prob,
+            priority_scores=scores,
+        )
+        keep = rng.random(costs.size) < q
+        if not keep.any():
+            # Degenerate draw; keep the single most likely response so the
+            # update is still well defined.
+            keep[int(np.argmax(q))] = True
+
+        weights = 1.0 / q[keep]
+        parts = []
+        offset = 0
+        for batch, batch_costs in zip(self._batches, self._costs, strict=True):
+            local = keep[offset : offset + batch_costs.size]
+            offset += batch_costs.size
+            if local.any():
+                parts.append(batch.select_idxs(np.nonzero(local)[0]))
+        selected = DataProto.concat(parts) if len(parts) > 1 else parts[0]
+
+        # ``parts`` preserves buffer order and ``nonzero`` is sorted, so the
+        # concatenated rows line up with ``weights``.
+        selected.batch[REPLAY_WEIGHT_KEY] = torch.as_tensor(weights, dtype=torch.float32)
+        _rebuild_row_aligned_meta_info(selected)
+
+        selected_costs = costs[keep]
+        weight_sum = float(weights.sum())
+        stats = {
+            "replay/buffer_batches": float(len(self._batches)),
+            "replay/buffer_responses": float(costs.size),
+            "replay/buffer_tokens": float(costs.sum()),
+            "replay/buffer_host_gib": self.nbytes / 1024**3,
+            "replay/target_tokens": float(budget),
+            "replay/selected_responses": float(keep.sum()),
+            "replay/selected_tokens": float(selected_costs.sum()),
+            # Should track buffer_tokens: the weighted count is the denominator
+            # the token-mean objective is normalized by.
+            "replay/weighted_tokens": float(weights @ selected_costs),
+            "replay/selection_ess_frac": float(weight_sum**2 / (float(weights @ weights) * weights.size)),
+            "replay/weight_max": float(weights.max()),
+            "replay/inclusion_prob_min": float(q.min()),
+            "replay/inclusion_prob_saturated_frac": float((q >= 1.0).mean()),
+            # How often the q_min floor binds. If this is large the priority is
+            # being overridden for much of the buffer and gamma means less than
+            # it appears to.
+            "replay/inclusion_prob_floored_frac": float((q <= min_inclusion_prob).mean()),
+            "replay/selected_mean_length": float(selected_costs.mean()),
+            "replay/buffer_mean_length": float(costs.mean()),
+        }
+        if scores is not None:
+            # Whether the draw really landed on the high-divergence responses, and
+            # not only on the ones the score happens to rank highest.
+            stats["replay/buffer_mean_score"] = float(scores.mean())
+            stats["replay/selected_mean_score"] = float(scores[keep].mean())
+            stats["replay/selected_score_ratio"] = float(scores[keep].mean() / scores.mean())
+        return selected, stats
