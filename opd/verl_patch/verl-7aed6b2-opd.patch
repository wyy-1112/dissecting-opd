+def assign_global_batch_num_tokens(data: TensorDict, dp_group=None) -> None:
+    """Assign the token-mean normalization denominator for the global batch.
+
+    Under prioritized replay the batch carries per-response inverse-inclusion
+    weights, and the token-mean objective is a ratio whose numerator and
+    denominator must be weighted alike. Weighting only the numerator would tilt
+    the update towards long responses. Every engine routes through here so that
+    no backend can silently normalize by an unweighted token count.
+    """
+    batch_num_tokens = weighted_token_count(data["loss_mask"], data.get(REPLAY_WEIGHT_KEY, None)).to(get_device_id())
+    if dp_group is not None:
+        torch.distributed.all_reduce(batch_num_tokens, op=torch.distributed.ReduceOp.SUM, group=dp_group)
+    tu.assign_non_tensor(data, batch_num_tokens=batch_num_tokens.item())
+
