+"""Gates that decide when a replayed batch is spent.
+
+The thresholds these exercise are calibrated against arms B, C and E3, where
+three replay draws left RMS K1 at 87-98% of its fresh value and the clip
+fraction at 1-3%. That is why the interesting cases here are ratios near one
+being allowed to continue: a gate that fired at those levels would collapse the
+adaptive arm into a fixed shallow one.
+"""
+
+import pytest
+import torch
+
+from verl.trainer.config.algorithm import ReplayConfig
+from verl.trainer.distillation.losses import compute_policy_staleness_metrics
+from verl.trainer.ppo.replay import evaluate_replay_continuation
+
+GATES = {
+    "learn_gap_floor_fraction": 0.7,
+    "clip_fraction_ceiling": 0.15,
+    "ess_floor_fraction": 0.5,
+}
+
+
+def verdict(learn_gap=1.0, reference=1.0, clip=0.0, ess=1.0, **overrides):
+    return evaluate_replay_continuation(
+        learn_gap=learn_gap,
+        reference_learn_gap=reference,
+        clip_fraction=clip,
+        ess_fraction=ess,
+        **{**GATES, **overrides},
+    )
+
+
+class TestContinuationGates:
+    def test_a_batch_that_still_diverges_and_is_fresh_keeps_replaying(self):
+        result = verdict(learn_gap=0.95, reference=1.0, clip=0.02, ess=0.9)
+        assert result.should_continue
+        assert result.reason == "continue"
+
+    def test_the_observed_depth_three_operating_point_does_not_stop(self):
+        # Arm B's mean: RMS K1 at 87% of reference, clip fraction 0.011.
+        assert verdict(learn_gap=0.874, reference=1.0, clip=0.011, ess=0.95).should_continue
+
+    def test_a_consumed_teacher_gap_stops_replay(self):
+        result = verdict(learn_gap=0.69, reference=1.0)
+        assert not result.should_continue
+        assert result.reason == "learn_gap_exhausted"
+
+    def test_the_floor_is_inclusive_so_exactly_at_it_continues(self):
+        assert verdict(learn_gap=0.7, reference=1.0).should_continue
+
+    def test_excessive_clipping_stops_replay(self):
+        result = verdict(clip=0.16)
+        assert not result.should_continue
+        assert result.reason == "off_policy_clipping"
+
+    def test_a_collapsed_effective_sample_size_stops_replay(self):
+        result = verdict(ess=0.49)
+        assert not result.should_continue
+        assert result.reason == "off_policy_ess"
+
+    def test_an_exhausted_gap_is_reported_ahead_of_staleness(self):
+        # All three gates fail at once; the report names the one that describes
+        # the batch having nothing left to give, which is the benign reason.
+        result = verdict(learn_gap=0.1, reference=1.0, clip=0.9, ess=0.01)
+        assert result.reason == "learn_gap_exhausted"
+
+    def test_ratios_are_reported_for_logging(self):
+        result = verdict(learn_gap=0.4, reference=0.8, clip=0.03, ess=0.77)
+        assert result.learn_ratio == pytest.approx(0.5)
+        assert result.clip_fraction == pytest.approx(0.03)
+        assert result.ess_fraction == pytest.approx(0.77)
+        assert result.as_metrics()["replay/adaptive_continue"] == 0.0
+
+    def test_a_zero_reference_does_not_divide_by_zero(self):
+        # A batch the student already matches exactly has no ratio to speak of;
+        # treating it as unexhausted defers to the staleness gates rather than
+        # stopping on a degenerate division.
+        result = verdict(learn_gap=0.0, reference=0.0)
+        assert result.learn_ratio == 1.0
+        assert result.should_continue
+
+
+class TestStalenessMetrics:
+    def test_an_unmoved_policy_has_zero_drift_and_full_sample_size(self):
+        log_prob = torch.tensor([[-1.0, -2.0, -3.0]])
+        mask = torch.ones(1, 3, dtype=torch.bool)
+        metrics = compute_policy_staleness_metrics(
+            log_prob=log_prob, old_log_prob=log_prob.clone(), loss_mask=mask
+        )
+        assert metrics["distillation/logratio_square_mean"].aggregate() == pytest.approx(0.0)
+        assert metrics["distillation/ratio_ess_frac"].aggregate() == pytest.approx(1.0)
+
+    def test_drift_is_the_mean_square_log_ratio(self):
+        old = torch.zeros(1, 2)
+        new = torch.tensor([[0.3, -0.5]])
+        metrics = compute_policy_staleness_metrics(
+            log_prob=new, old_log_prob=old, loss_mask=torch.ones(1, 2, dtype=torch.bool)
+        )
+        expected = (0.3**2 + 0.5**2) / 2
+        assert metrics["distillation/logratio_square_mean"].aggregate() == pytest.approx(expected)
+
+    def test_masked_tokens_are_excluded(self):
+        old = torch.zeros(1, 3)
+        new = torch.tensor([[0.2, 99.0, -0.2]])
+        mask = torch.tensor([[True, False, True]])
+        metrics = compute_policy_staleness_metrics(log_prob=new, old_log_prob=old, loss_mask=mask)
+        assert metrics["distillation/logratio_square_mean"].aggregate() == pytest.approx(0.04)
+
+    def test_one_token_dominating_the_weights_collapses_the_sample_size(self):
+        # Eight tokens unchanged and one with a large positive log-ratio: the
+        # effective sample size should be a small fraction of nine.
+        old = torch.zeros(1, 9)
+        new = torch.zeros(1, 9)
+        new[0, 0] = 6.0
+        metrics = compute_policy_staleness_metrics(
+            log_prob=new, old_log_prob=old, loss_mask=torch.ones(1, 9, dtype=torch.bool)
+        )
+        assert metrics["distillation/ratio_ess_frac"].aggregate() < 0.2
+
+    def test_the_sample_size_fraction_never_exceeds_one(self):
+        torch.manual_seed(0)
+        old = torch.zeros(1, 64)
+        new = torch.randn(1, 64) * 0.1
+        metrics = compute_policy_staleness_metrics(
+            log_prob=new, old_log_prob=old, loss_mask=torch.ones(1, 64, dtype=torch.bool)
+        )
+        assert 0.0 < metrics["distillation/ratio_ess_frac"].aggregate() <= 1.0 + 1e-6
+
+
+class TestAdaptiveConfigValidation:
+    def test_the_adaptive_defaults_validate(self):
+        ReplayConfig(enable=True, adaptive_depth=True, updates_per_cycle=13)
+
+    def test_fixed_depth_arms_are_not_subject_to_the_adaptive_checks(self):
+        # The gate fields keep their defaults on a fixed arm, so validating them
+        # there would reject configurations that never read them.
+        ReplayConfig(enable=True, adaptive_depth=False, learn_gap_floor_fraction=5.0)
+
+    def test_a_floor_that_leaves_the_cap_nothing_to_cap_is_rejected(self):
+        with pytest.raises(ValueError, match="min_replays_per_cycle"):
+            ReplayConfig(enable=True, adaptive_depth=True, updates_per_cycle=2, min_replays_per_cycle=2)
+
+    def test_zero_minimum_replays_is_rejected(self):
+        with pytest.raises(ValueError, match="min_replays_per_cycle"):
+            ReplayConfig(enable=True, adaptive_depth=True, min_replays_per_cycle=0)
+
+    @pytest.mark.parametrize("value", [0.0, 1.5])
+    def test_an_out_of_range_learn_gap_floor_is_rejected(self, value):
+        with pytest.raises(ValueError, match="learn_gap_floor_fraction"):
+            ReplayConfig(enable=True, adaptive_depth=True, learn_gap_floor_fraction=value)
+
+    def test_an_out_of_range_clip_ceiling_is_rejected(self):
+        with pytest.raises(ValueError, match="clip_fraction_ceiling"):
+            ReplayConfig(enable=True, adaptive_depth=True, clip_fraction_ceiling=0.0)
+
+    def test_an_out_of_range_ess_floor_is_rejected(self):
+        with pytest.raises(ValueError, match="ess_floor_fraction"):
+            ReplayConfig(enable=True, adaptive_depth=True, ess_floor_fraction=1.0)
+
+    def test_a_nonpositive_update_budget_is_rejected(self):
+        with pytest.raises(ValueError, match="max_optimizer_updates"):
+            ReplayConfig(enable=True, adaptive_depth=True, max_optimizer_updates=0)
