+            )
+        }
+        for index, name in enumerate(names):
+            metrics[f"opd_grad/{name}_norm"] = Metric(
+                AggregationType.MEAN, norms[index].item()
+            )
+            metrics[f"opd_grad/{name}_energy_fraction"] = Metric(
+                AggregationType.MEAN,
+                (packed[index] / energy_denominator).item(),
+            )
+        return metrics
