+"""The names adaptive replay reads its gates by.
+
+Adaptive replay looks its three signals up by string key in the metrics an
+actor update returns. A rename would leave the trainer with no gap signal, and
+the safest-looking default for a missing gap -- zero -- reads as "nothing left
+to learn", which would silently turn the arm into a fixed depth-one one. The
+trainer raises instead of defaulting, and these pin the names so that raise
+never has to happen.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from tensordict import TensorDict
+
+from verl.trainer.distillation.losses import (
+    compute_distillation_loss_reverse_kl_estimator,
+    compute_policy_staleness_metrics,
+)
+
+# Exactly the keys verl.trainer.ppo.ray_trainer requires of a replay update,
+# with the "replay/actor/" prefix that _replay_update adds stripped off.
+GATE_KEYS = (
+    "distillation/k1_square_mean",
+    "distillation/pg_clipfrac",
+    "distillation/ratio_ess_frac",
+)
+
+
+def k1_metrics(student, teacher, mask):
+    """Metrics for one sequence whose response log probabilities are given.
+
+    The loss takes model output flat-packed over prompt and response tokens and
+    slices the response out left-shifted by one, so with a single prompt token
+    the response values are the leading entries of the flat tensor and one
+    trailing slot goes unread.
+    """
+    length = student.numel()
+    flat_student = torch.cat([student.reshape(-1), torch.zeros(1)])
+    flat_teacher = torch.cat([teacher.reshape(-1), torch.zeros(1)]).unsqueeze(-1)
+    data = TensorDict(
+        {
+            "prompts": torch.zeros(1, 1, dtype=torch.long),
+            "responses": torch.zeros(1, length, dtype=torch.long),
+            "attention_mask": torch.ones(1, length + 1, dtype=torch.long),
+            "teacher_logprobs": flat_teacher,
+            "response_mask": mask.reshape(1, length),
+        },
+        # Unconstrained, because the flat-packed entries are indexed by token
+        # while the padded ones are indexed by sequence.
+        batch_size=[],
+    )
+    _, metrics = compute_distillation_loss_reverse_kl_estimator(
+        config=SimpleNamespace(),
+        distillation_config=SimpleNamespace(
+            distillation_loss=SimpleNamespace(loss_mode="k1")
+        ),
+        model_output={"log_probs": flat_student},
+        data=data,
+    )
+    return metrics
+
+
+class TestGateMetricNames:
+    def test_the_learn_gap_metric_is_emitted_under_the_expected_name(self):
+        metrics = k1_metrics(
+            student=torch.tensor([[-1.0, -2.0]]),
+            teacher=torch.tensor([[-1.5, -1.0]]),
+            mask=torch.tensor([[1, 1]], dtype=torch.bool),
+        )
+        assert "distillation/k1_square_mean" in metrics
+
+    def test_the_staleness_metric_is_emitted_under_the_expected_name(self):
+        metrics = compute_policy_staleness_metrics(
+            log_prob=torch.zeros(1, 2),
+            old_log_prob=torch.zeros(1, 2),
+            loss_mask=torch.ones(1, 2, dtype=torch.bool),
+        )
+        assert "distillation/ratio_ess_frac" in metrics
+
+    def test_every_gate_key_is_accounted_for(self):
+        # pg_clipfrac comes from the shared PPO policy loss rather than from
+        # either helper, and is already present in the arms that have run, so
+        # this asserts only that the set has not grown a name nothing produces.
+        produced = set(
+            k1_metrics(
+                student=torch.tensor([[-1.0, -2.0]]),
+                teacher=torch.tensor([[-1.5, -1.0]]),
+                mask=torch.tensor([[1, 1]], dtype=torch.bool),
+            )
+        ) | set(
+            compute_policy_staleness_metrics(
+                log_prob=torch.zeros(1, 2),
+                old_log_prob=torch.zeros(1, 2),
+                loss_mask=torch.ones(1, 2, dtype=torch.bool),
+            )
+        )
+        assert set(GATE_KEYS) - produced == {"distillation/pg_clipfrac"}
+
+
+class TestLearnGapValue:
+    def test_it_is_the_mean_square_gap_not_the_squared_mean(self):
+        # Gaps of +0.5 and -0.5 have a signed mean of zero. A batch whose
+        # responses disagree in both directions still carries a large gradient
+        # coefficient on every token, so the gap the gates read must not vanish.
+        metrics = k1_metrics(
+            student=torch.tensor([[-1.0, -1.0]]),
+            teacher=torch.tensor([[-1.5, -0.5]]),
+            mask=torch.tensor([[1, 1]], dtype=torch.bool),
+        )
+        assert metrics["distillation/k1_mean"].aggregate() == pytest.approx(0.0)
+        assert metrics["distillation/k1_square_mean"].aggregate() == pytest.approx(0.25)
+
+    def test_masked_tokens_do_not_enter_the_gap(self):
+        metrics = k1_metrics(
+            student=torch.tensor([[-1.0, -1.0, -1.0]]),
+            teacher=torch.tensor([[-1.2, -9.0, -0.8]]),
+            mask=torch.tensor([[1, 0, 1]], dtype=torch.bool),
+        )
+        assert metrics["distillation/k1_square_mean"].aggregate() == pytest.approx(0.04)
+
+    def test_a_matched_student_reports_no_gap_left(self):
+        student = torch.tensor([[-1.0, -2.0, -3.0]])
+        metrics = k1_metrics(
+            student=student,
+            teacher=student.clone(),
+            mask=torch.ones(1, 3, dtype=torch.bool),
+        )
+        assert metrics["distillation/k1_square_mean"].aggregate() == pytest.approx(0.0)
diff --git a/tests/trainer/test_replay_loss_weighting_on_cpu.py b/tests/trainer/test_replay_loss_weighting_on_cpu.py
new file mode 100644
index 0000000..1882449
--- /dev/null
+++ b/tests/trainer/test_replay_loss_weighting_on_cpu.py
@@ -0,0 +1,181 @@
+"""Tests for how replay weights enter the OPD policy loss.
+
+The weight is applied by scaling the per-response advantage rather than by
+masking, because the clipped PPO objective is positively homogeneous in the
+advantage: that scales the loss numerator exactly while leaving the clip
+fractions and ``ppo_kl`` as unweighted diagnostics. The matching denominator is
+supplied through ``batch_num_tokens``. These tests pin down both halves and the
+fact that a unit weight is a no-op.
+"""
+
+import numpy as np
+import pytest
+import torch
+
+from verl.trainer.ppo.core_algos import compute_policy_loss_vanilla
+from verl.trainer.ppo.replay import solve_inclusion_probabilities
+from verl.utils.replay_weights import weighted_token_count
+from verl.workers.config import DistillationLossConfig
+
+GAMMA = 0.75
+WIDTH = 24
+
+
+def _loss_config(batch_num_tokens):
+    return DistillationLossConfig(
+        loss_mode="k1",
+        use_task_rewards=False,
+        use_policy_gradient=True,
+        clip_ratio=0.2,
+        clip_ratio_low=0.2,
+        clip_ratio_high=0.2,
+        global_batch_info={
+            "dp_size": 1,
+            "batch_num_tokens": batch_num_tokens,
+            "global_batch_size": None,
+            "loss_scale_factor": None,
+        },
+    )
+
+
+def _make_cohort(rng, n=64):
+    lengths = rng.integers(4, WIDTH + 1, size=n)
+    mask = torch.zeros(n, WIDTH)
+    for i, length in enumerate(lengths):
+        mask[i, :length] = 1.0
+    old_log_prob = torch.as_tensor(rng.normal(-1.0, 0.5, size=(n, WIDTH)), dtype=torch.float32)
+    # A drifted policy, so ratios sit away from one and clipping is exercised.
+    log_prob = old_log_prob + torch.as_tensor(rng.normal(0.0, 0.25, size=(n, WIDTH)), dtype=torch.float32)
+    k1 = torch.as_tensor(rng.normal(0.3, 0.4, size=(n, WIDTH)), dtype=torch.float32)
+    return mask, old_log_prob, log_prob, k1, lengths.astype(np.float64)
+
+
+def _policy_loss(mask, old_log_prob, log_prob, k1, weights, denominator):
+    advantages = -k1
+    if weights is not None:
+        advantages = advantages * torch.as_tensor(weights, dtype=torch.float32).reshape(-1, 1)
+    return compute_policy_loss_vanilla(
+        old_log_prob=old_log_prob,
+        log_prob=log_prob,
+        advantages=advantages,
+        response_mask=mask,
+        loss_agg_mode="token-mean",
+        config=_loss_config(denominator),
+    )
+
+
+def test_unit_weights_reproduce_the_unweighted_loss():
+    rng = np.random.default_rng(0)
+    mask, old_log_prob, log_prob, k1, lengths = _make_cohort(rng)
+    denominator = float(lengths.sum())
+
+    plain, plain_metrics = _policy_loss(mask, old_log_prob, log_prob, k1, None, denominator)
+    unit, unit_metrics = _policy_loss(mask, old_log_prob, log_prob, k1, np.ones(lengths.size), denominator)
+
+    # Runs without replay must be numerically untouched by this code path.
+    assert unit.item() == pytest.approx(plain.item(), rel=1e-6)
+    assert unit_metrics == plain_metrics
+
+
+def test_weighting_scales_the_numerator_exactly():
+    rng = np.random.default_rng(1)
+    mask, old_log_prob, log_prob, k1, lengths = _make_cohort(rng)
+    weights = rng.uniform(0.5, 4.0, size=lengths.size)
+    denominator = float((weights * lengths).sum())
+
+    weighted, _ = _policy_loss(mask, old_log_prob, log_prob, k1, weights, denominator)
+
+    # Recompute the intended estimator directly from per-response losses: the
+    # weighted token sum over the weighted token count.
+    per_response = torch.stack(
+        [
+            _policy_loss(
+                mask[i : i + 1],
+                old_log_prob[i : i + 1],
+                log_prob[i : i + 1],
+                k1[i : i + 1],
+                None,
+                1.0,
+            )[0]
+            for i in range(lengths.size)
+        ]
+    )
+    expected = float((torch.as_tensor(weights, dtype=torch.float32) * per_response).sum()) / denominator
+
+    assert weighted.item() == pytest.approx(expected, rel=1e-5)
+
+
+def test_weighting_leaves_clip_and_kl_diagnostics_unchanged():
+    rng = np.random.default_rng(2)
+    mask, old_log_prob, log_prob, k1, lengths = _make_cohort(rng)
+    weights = rng.uniform(0.5, 4.0, size=lengths.size)
+
+    _, plain_metrics = _policy_loss(mask, old_log_prob, log_prob, k1, None, float(lengths.sum()))
+    _, weighted_metrics = _policy_loss(
+        mask, old_log_prob, log_prob, k1, weights, float((weights * lengths).sum())
+    )
+
+    # Clip rate and ppo_kl are reported to compare arms, so they must describe
+    # the responses actually trained on rather than the importance weights.
+    assert weighted_metrics["actor/pg_clipfrac"] == pytest.approx(plain_metrics["actor/pg_clipfrac"])
+    assert weighted_metrics["actor/ppo_kl"] == pytest.approx(plain_metrics["actor/ppo_kl"])
+    assert weighted_metrics["actor/pg_clipfrac_lower"] == pytest.approx(plain_metrics["actor/pg_clipfrac_lower"])
+
+
+def test_zero_weight_rows_do_not_affect_the_loss():
+    rng = np.random.default_rng(3)
+    mask, old_log_prob, log_prob, k1, lengths = _make_cohort(rng, n=32)
+    weights = np.ones(lengths.size)
+    denominator = float(lengths.sum())
+    reference, _ = _policy_loss(mask, old_log_prob, log_prob, k1, weights, denominator)
+
+    # Append duplicated rows the way data-parallel padding does, at zero weight.
+    padded_mask = torch.cat([mask, mask[:5]], dim=0)
+    padded_old = torch.cat([old_log_prob, old_log_prob[:5]], dim=0)
+    padded_new = torch.cat([log_prob, log_prob[:5]], dim=0)
+    padded_k1 = torch.cat([k1, k1[:5]], dim=0)
+    padded_weights = np.concatenate([weights, np.zeros(5)])
+
+    padded, _ = _policy_loss(
+        padded_mask,
+        padded_old,
+        padded_new,
+        padded_k1,
+        padded_weights,
+        float(weighted_token_count(padded_mask, torch.as_tensor(padded_weights, dtype=torch.float32)).item()),
+    )
+
+    assert padded.item() == pytest.approx(reference.item(), rel=1e-6)
+
+
+def test_weighted_denominator_recovers_the_full_cohort_loss():
+    """End-to-end check of the estimator the replay arms rely on.
+
+    A prioritized draw plus inverse-probability weights, normalized by the
+    weighted token count, should reproduce the loss a full-cohort update would
+    have computed. Normalizing by the drawn subset's plain token count instead
+    leaves a visible length-driven bias.
+    """
+    rng = np.random.default_rng(4)
+    mask, old_log_prob, log_prob, k1, lengths = _make_cohort(rng, n=256)
+    truth, _ = _policy_loss(mask, old_log_prob, log_prob, k1, None, float(lengths.sum()))
+
+    q = solve_inclusion_probabilities(
+        lengths, 0.25 * lengths.sum(), priority_exponent=GAMMA, min_inclusion_prob=0.02
+    )
+    draw_rng = np.random.default_rng(5)
+    weighted, unweighted = [], []
+    for _ in range(400):
+        keep = draw_rng.random(lengths.size) < q
+        if not keep.any():
+            continue
+        idx = torch.as_tensor(np.nonzero(keep)[0])
+        w = 1.0 / q[keep]
+        sub = (mask[idx], old_log_prob[idx], log_prob[idx], k1[idx])
+        weighted.append(_policy_loss(*sub, w, float((w * lengths[keep]).sum()))[0].item())
+        unweighted.append(_policy_loss(*sub, w, float(lengths[keep].sum()))[0].item())
+
+    weighted_err = abs(np.mean(weighted) - truth.item()) / abs(truth.item())
+    unweighted_err = abs(np.mean(unweighted) - truth.item()) / abs(truth.item())
+    assert weighted_err < 0.02
+    assert unweighted_err > 0.2
