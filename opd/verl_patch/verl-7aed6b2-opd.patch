+def patch_prompt_logprobs_optional_temperature() -> bool:
+    """Bridge a vLLM 0.10 sampler/caller signature mismatch for OPD.
+
+    Some internal builds require ``compute_logprobs(logits, temp)`` while the
+    prompt-logprob path still calls ``compute_logprobs(logits)``. Apply the
+    identity temperature lazily inside the already GPU-assigned server actor.
+    """
+
+    if os.getenv("OPD_PATCH_VLLM_PROMPT_LOGPROBS", "").lower() not in {
+        "1",
+        "true",
+        "yes",
+    }:
+        return False
+
+    import torch
+    from vllm.v1.sample.sampler import Sampler
+
+    descriptor = Sampler.__dict__.get("compute_logprobs")
+    if descriptor is None:
+        return False
+    function = descriptor.__func__ if isinstance(descriptor, staticmethod) else descriptor
+    if getattr(function, "_opd_optional_temperature", False):
+        return True
+    if "temp" not in inspect.signature(function).parameters:
+        return False
+
+    def identity_temperature(logits):
+        return torch.ones(
+            logits.shape[0],
+            device=logits.device,
+            dtype=logits.dtype,
+        )
+
+    if isinstance(descriptor, staticmethod):
+        original = function
+
+        def compute_logprobs(logits, temp=None):
+            return original(
+                logits,
+                identity_temperature(logits) if temp is None else temp,
+            )
+
+        compute_logprobs._opd_optional_temperature = True
+        Sampler.compute_logprobs = staticmethod(compute_logprobs)
+    else:
+        original = function
+
+        def compute_logprobs(self, logits, temp=None):
+            return original(
+                self,
+                logits,
+                identity_temperature(logits) if temp is None else temp,
+            )
+
+        compute_logprobs._opd_optional_temperature = True
+        Sampler.compute_logprobs = compute_logprobs
+    logger.info("Patched vLLM prompt logprobs with identity default temperature")
+    return True
+
+
+def configure_opd_enginecore_sitecustomize() -> bool:
+    """Apply the OPD shim here and inject it into spawned vLLM processes.
+
+    Updating ``PYTHONPATH`` is enough for future EngineCore/Worker processes,
+    but the current HTTP/AsyncLLM process owns ``LogprobsProcessor`` and must
+    also apply the shim explicitly so extra prompt-logprob columns survive
+    conversion to dictionaries.
+    """
+
+    if os.getenv("OPD_PATCH_VLLM_PROMPT_LOGPROBS", "").lower() not in {
+        "1",
+        "true",
+        "yes",
+    }:
+        return False
+    patch_path = os.getenv("OPD_VLLM_PATCH_PATH")
+    if not patch_path or not os.path.isfile(
+        os.path.join(patch_path, "sitecustomize.py")
+    ):
+        raise RuntimeError(
+            "OPD_VLLM_PATCH_PATH must contain sitecustomize.py when the "
+            "prompt-logprob compatibility patch is enabled"
+        )
+    existing = os.environ.get("PYTHONPATH", "")
+    entries = [entry for entry in existing.split(os.pathsep) if entry]
+    if patch_path not in entries:
+        os.environ["PYTHONPATH"] = os.pathsep.join([patch_path, *entries])
+
+    module_name = "_opd_vllm_sitecustomize"
+    if module_name not in sys.modules:
+        sitecustomize_path = os.path.join(patch_path, "sitecustomize.py")
+        spec = importlib.util.spec_from_file_location(
+            module_name, sitecustomize_path
+        )
+        if spec is None or spec.loader is None:
+            raise RuntimeError(
+                f"failed to load OPD sitecustomize from {sitecustomize_path}"
+            )
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[module_name] = module
+        try:
+            spec.loader.exec_module(module)
+        except Exception:
+            sys.modules.pop(module_name, None)
+            raise
+
+    logger.info("Configured OPD EngineCore sitecustomize path: %s", patch_path)
+    return True
+
