+"""Probes written during a review of the replay implementation.
+
+These are not feature tests; each one pins down whether a specific suspected
+defect is real.
+"""
+
+import numpy as np
+import torch
+from tensordict import TensorDict
+
+from verl.protocol import DataProto
+from verl.trainer.ppo.replay import (
+    REPLAY_COST_KEY,
+    FIFOReplayBuffer,
+    pad_replay_batch_for_data_parallel,
+)
+from verl.utils.replay_weights import REPLAY_WEIGHT_KEY
+
+
+def _make_batch(n: int, seq: int = 16, seed: int = 0) -> DataProto:
+    rng = np.random.default_rng(seed)
+    lengths = rng.integers(4, seq, size=n)
+    attention_mask = torch.zeros(n, seq, dtype=torch.long)
+    loss_mask = torch.zeros(n, seq, dtype=torch.bool)
+    for i, length in enumerate(lengths):
+        attention_mask[i, :length] = 1
+        loss_mask[i, :length] = True
+    batch = TensorDict(
+        {
+            "attention_mask": attention_mask,
+            "loss_mask": loss_mask,
+            REPLAY_COST_KEY: loss_mask.sum(-1).float(),
+        },
+        batch_size=(n,),
+    )
+    return DataProto(
+        batch=batch,
+        non_tensor_batch={},
+        meta_info={"global_token_num": attention_mask.sum(-1).tolist(), "temperature": 1.0},
+    )
+
+
+def test_draw_does_not_mutate_the_buffered_batch_meta_info():
+    """A draw must not write row-aligned meta-info back into the stored batch.
+
+    ``DataProto.select_idxs`` passes ``meta_info`` through by reference, so
+    rebuilding the drawn batch's per-row entries can reach into the buffer.
+    """
+    buffer = FIFOReplayBuffer(capacity=1)
+    buffer.push(_make_batch(32, seed=1))
+    stored = buffer._batches[0]
+
+    buffer.sample(
+        budget=0.25 * buffer.total_tokens,
+        priority_exponent=0.75,
+        min_inclusion_prob=0.05,
+        rng=np.random.default_rng(0),
+    )
+
+    assert "global_token_num" not in stored.meta_info, (
+        f"the draw leaked row-aligned meta-info into the buffer: "
+        f"{len(stored.meta_info['global_token_num'])} entries for {len(stored)} stored rows"
+    )
+
+
+def test_repeated_draws_from_a_deep_buffer_do_not_conflict():
+    """Two draws spanning several batches must both succeed.
+
+    If a draw writes ``global_token_num`` back into each stored batch, the next
+    draw's ``DataProto.concat`` sees per-batch disagreement and asserts.
+    """
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_batch(16, seed=i))
+
+    for draw in range(3):
+        selected, _ = buffer.sample(
+            budget=0.25 * buffer.total_tokens,
+            priority_exponent=0.75,
+            min_inclusion_prob=0.05,
+            rng=np.random.default_rng(draw),
+        )
+        assert len(selected.meta_info["global_token_num"]) == len(selected)
+
+
+def test_padded_rows_are_excluded_from_both_sides_of_the_ratio():
+    """Zero-weight padding must not move the token-mean loss."""
+    from verl.utils.replay_weights import weighted_token_count
+
+    buffer = FIFOReplayBuffer(capacity=1)
+    buffer.push(_make_batch(30, seed=7))
+    selected, _ = buffer.sample(
+        budget=0.5 * buffer.total_tokens,
+        priority_exponent=0.75,
+        min_inclusion_prob=0.05,
+        rng=np.random.default_rng(3),
+    )
+
+    before = weighted_token_count(selected.batch["loss_mask"], selected.batch[REPLAY_WEIGHT_KEY])
+    padded, pad_size = pad_replay_batch_for_data_parallel(selected, len(selected) + 1)
+    after = weighted_token_count(padded.batch["loss_mask"], padded.batch[REPLAY_WEIGHT_KEY])
+
+    assert pad_size == 1
+    torch.testing.assert_close(before, after)
+
+
+def test_padding_does_not_zero_the_weights_of_the_rows_it_copies():
+    """Padding repeats real rows; the originals must keep their weight.
+
+    ``pad_dataproto_to_divisor`` appends copies taken from the front of the
+    batch, so a writer that zeroed the wrong slice would silently drop the
+    first responses of every draw from the loss.
+    """
+    buffer = FIFOReplayBuffer(capacity=1)
+    buffer.push(_make_batch(30, seed=11))
+    selected, _ = buffer.sample(
+        budget=0.5 * buffer.total_tokens,
+        priority_exponent=0.75,
+        min_inclusion_prob=0.05,
+        rng=np.random.default_rng(5),
+    )
+    original = selected.batch[REPLAY_WEIGHT_KEY].clone()
+
+    padded, pad_size = pad_replay_batch_for_data_parallel(selected, len(selected) + 3)
+
+    assert pad_size == 3
+    torch.testing.assert_close(padded.batch[REPLAY_WEIGHT_KEY][: len(original)], original)
+    assert torch.all(padded.batch[REPLAY_WEIGHT_KEY][len(original) :] == 0.0)
diff --git a/tests/trainer/test_replay_rms_k1_priority_on_cpu.py b/tests/trainer/test_replay_rms_k1_priority_on_cpu.py
new file mode 100644
index 0000000..cb2936c
--- /dev/null
+++ b/tests/trainer/test_replay_rms_k1_priority_on_cpu.py
@@ -0,0 +1,246 @@
+# Copyright 2025 Bytedance Ltd. and/or its affiliates
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""RMS-K1 replay priority: the score itself, and the sampler that consumes it."""
+
+import numpy as np
+import pytest
+import torch
+from tensordict import TensorDict
+
+from verl.protocol import DataProto
+from verl.trainer.config.algorithm import ReplayConfig
+from verl.trainer.ppo.replay import (
+    REPLAY_COST_KEY,
+    REPLAY_SCORE_KEY,
+    FIFOReplayBuffer,
+    solve_inclusion_probabilities,
+)
+from verl.utils.replay_weights import per_sample_rms_k1
+
+
+def _batch(costs, scores=None, response_length=8):
+    size = len(costs)
+    mask = torch.zeros(size, response_length)
+    for row, cost in enumerate(costs):
+        mask[row, : int(cost)] = 1.0
+    tensors = {
+        "response_mask": mask,
+        "attention_mask": torch.ones(size, response_length),
+        REPLAY_COST_KEY: torch.tensor(costs, dtype=torch.float32),
+    }
+    if scores is not None:
+        tensors[REPLAY_SCORE_KEY] = torch.tensor(scores, dtype=torch.float32)
+    return DataProto(batch=TensorDict(tensors, batch_size=[size]))
+
+
+# --------------------------------------------------------------------- score ----
+
+
+def test_rms_k1_is_unaffected_by_sign_cancellation():
+    """A response whose disagreement flips sign must not score near zero.
+
+    This is the whole reason RMS is used instead of the signed mean: the signed
+    mean of this response is exactly zero while every token carries a large
+    gradient coefficient.
+    """
+    loss_mask = torch.ones(2, 4)
+    student = torch.zeros(2, 4)
+    teacher = torch.tensor(
+        [
+            [2.0, -2.0, 2.0, -2.0],  # signed mean 0, RMS 2
+            [0.5, 0.5, 0.5, 0.5],  # signed mean 0.5, RMS 0.5
+        ]
+    )
+    rms = per_sample_rms_k1(student, teacher, loss_mask)
+    signed = ((teacher - student) * loss_mask).sum(-1) / loss_mask.sum(-1)
+
+    assert signed[0].abs() < 1e-6
+    torch.testing.assert_close(rms, torch.tensor([2.0, 0.5]))
+    # The alternating response is the one that should be prioritized.
+    assert rms[0] > rms[1]
+
+
+def test_rms_k1_ignores_masked_tokens():
+    """Padding past a response's end must not dilute or inflate its score."""
+    loss_mask = torch.tensor([[1.0, 1.0, 0.0, 0.0]])
+    student = torch.zeros(1, 4)
+    teacher = torch.tensor([[3.0, 3.0, 100.0, -100.0]])
+    torch.testing.assert_close(
+        per_sample_rms_k1(student, teacher, loss_mask), torch.tensor([3.0])
+    )
+
+
+def test_rms_k1_clamp_bounds_outliers():
+    """One near-zero-probability token cannot decide a response's priority."""
+    loss_mask = torch.ones(1, 4)
+    student = torch.zeros(1, 4)
+    teacher = torch.tensor([[40.0, 0.0, 0.0, 0.0]])
+    unclamped = per_sample_rms_k1(student, teacher, loss_mask, clamp=1e9)
+    clamped = per_sample_rms_k1(student, teacher, loss_mask, clamp=10.0)
+    assert unclamped.item() == pytest.approx(20.0)
+    assert clamped.item() == pytest.approx(5.0)
+
+
+def test_rms_k1_is_symmetric_in_the_log_prob_difference():
+    """Only the magnitude of the gap matters, not which side is larger."""
+    loss_mask = torch.ones(1, 3)
+    left = torch.tensor([[0.0, -1.0, -2.0]])
+    right = torch.tensor([[-1.5, 0.5, 1.0]])
+    torch.testing.assert_close(
+        per_sample_rms_k1(left, right, loss_mask),
+        per_sample_rms_k1(right, left, loss_mask),
+    )
+
+
+def test_rms_k1_returns_zero_for_a_response_with_no_loss_tokens():
+    """Zero is the sampler's cue to fall back to the floor, not a divide by zero."""
+    loss_mask = torch.zeros(1, 4)
+    rms = per_sample_rms_k1(torch.zeros(1, 4), torch.ones(1, 4), loss_mask)
+    assert torch.isfinite(rms).all()
+    assert rms.item() == pytest.approx(0.0)
+
+
+# ------------------------------------------------------------------- sampler ----
+
+
+def test_explicit_scores_meet_the_token_budget():
+    costs = np.array([100.0, 400.0, 900.0, 1600.0])
+    scores = np.array([4.0, 1.0, 3.0, 2.0])
+    budget = 0.25 * costs.sum()
+    q = solve_inclusion_probabilities(
+        costs, budget, min_inclusion_prob=0.01, priority_scores=scores
+    )
+    assert float(q @ costs) == pytest.approx(budget, rel=1e-6)
+
+
+def test_scores_order_the_inclusion_probabilities_independently_of_length():
+    """The point of the divergence signal: a short response can outrank a long one."""
+    costs = np.array([100.0, 2000.0])
+    scores = np.array([10.0, 1.0])
+    q = solve_inclusion_probabilities(
+        costs, 0.25 * costs.sum(), min_inclusion_prob=0.01, priority_scores=scores
+    )
+    assert q[0] > q[1]
+
+
+def test_constant_scores_reproduce_the_uniform_arm():
+    costs = np.array([100.0, 400.0, 900.0, 1600.0])
+    budget = 0.25 * costs.sum()
+    uniform = solve_inclusion_probabilities(
+        costs, budget, priority_exponent=0.0, min_inclusion_prob=0.01
+    )
+    scored = solve_inclusion_probabilities(
+        costs, budget, min_inclusion_prob=0.01, priority_scores=np.ones_like(costs)
+    )
+    np.testing.assert_allclose(scored, uniform)
+
+
+def test_zero_scores_fall_back_to_the_smallest_positive_score():
+    """A response with no measured divergence must stay selectable.
+
+    Dropping it outright would make its inclusion probability zero, and a
+    Horvitz-Thompson estimator cannot reweight a response it can never draw, so
+    the update would be biased rather than merely noisier.
+    """
+    costs = np.array([500.0, 500.0, 500.0])
+    scores = np.array([0.0, 2.0, 4.0])
+    q = solve_inclusion_probabilities(
+        costs, 0.25 * costs.sum(), min_inclusion_prob=1e-6, priority_scores=scores
+    )
+    assert (q > 0).all()
+    # The zero is raised to the smallest positive score, so it ties with it
+    # rather than landing on the ``q_min`` floor.
+    assert q[0] == pytest.approx(q[1], rel=1e-6)
+    assert q[2] == pytest.approx(2.0 * q[1], rel=1e-6)
+
+
+def test_all_zero_scores_are_rejected():
+    costs = np.array([500.0, 500.0])
+    with pytest.raises(ValueError, match="at least one positive"):
+        solve_inclusion_probabilities(
+            costs, 0.25 * costs.sum(), min_inclusion_prob=0.01, priority_scores=np.zeros(2)
+        )
+
+
+def test_score_count_must_match_the_buffer():
+    costs = np.array([500.0, 500.0])
+    with pytest.raises(ValueError, match="expected 2 priority scores"):
+        solve_inclusion_probabilities(
+            costs, 0.25 * costs.sum(), min_inclusion_prob=0.01, priority_scores=np.ones(3)
+        )
+
+
+# -------------------------------------------------------------------- buffer ----
+
+
+def test_buffer_uses_pushed_scores_and_reports_the_draw_concentration():
+    costs = [4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0, 4.0]
+    scores = [1.0, 1.0, 1.0, 1.0, 8.0, 8.0, 8.0, 8.0]
+    buffer = FIFOReplayBuffer(capacity=1)
+    buffer.push(_batch(costs, scores))
+    np.testing.assert_allclose(buffer.scores(), np.array(scores))
+
+    rng = np.random.default_rng(0)
+    ratios = []
+    for _ in range(200):
+        selected, stats = buffer.sample(
+            0.25 * sum(costs), priority_exponent=0.0, min_inclusion_prob=0.01, rng=rng
+        )
+        assert selected is not None
+        ratios.append(stats["replay/selected_score_ratio"])
+    # The draw should land on the high-divergence half far more often than chance.
+    assert float(np.mean(ratios)) > 1.4
+
+
+def test_buffer_without_scores_still_uses_the_length_exponent():
+    """The length arms must be untouched by the score plumbing."""
+    costs = [1.0, 2.0, 4.0, 8.0]
+    buffer = FIFOReplayBuffer(capacity=1)
+    buffer.push(_batch(costs))
+    assert buffer.scores() is None
+
+    _, stats = buffer.sample(
+        0.5 * sum(costs),
+        priority_exponent=0.75,
+        min_inclusion_prob=0.01,
+        rng=np.random.default_rng(0),
+    )
+    assert "replay/selected_score_ratio" not in stats
+
+
+def test_partially_scored_buffer_is_treated_as_unscored():
+    """Mixing a scored and an unscored batch would apply two rules in one draw."""
+    buffer = FIFOReplayBuffer(capacity=2)
+    buffer.push(_batch([4.0, 4.0], [1.0, 2.0]))
+    buffer.push(_batch([4.0, 4.0]))
+    assert buffer.scores() is None
+
+
+# -------------------------------------------------------------------- config ----
+
+
+def test_config_rejects_an_unknown_priority_signal():
+    with pytest.raises(ValueError, match="priority_signal"):
+        ReplayConfig(enable=True, priority_signal="length_times_k1")
+
+
+def test_config_accepts_rms_k1():
+    config = ReplayConfig(enable=True, priority_signal="rms_k1")
+    assert config.priority_signal == "rms_k1"
+    assert config.rms_k1_clamp == 10.0
+
+
+def test_config_rejects_a_non_positive_clamp():
+    with pytest.raises(ValueError, match="rms_k1_clamp"):
+        ReplayConfig(enable=True, priority_signal="rms_k1", rms_k1_clamp=0.0)
diff --git a/tests/trainer/test_replay_sampler_on_cpu.py b/tests/trainer/test_replay_sampler_on_cpu.py
