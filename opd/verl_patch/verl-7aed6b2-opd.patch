+__all__ = ["AlgoConfig", "FilterGroupsConfig", "KLControlConfig", "ReplayConfig", "RolloutCorrectionConfig"]
+
+
+@dataclass
+class ReplayConfig(BaseConfig):
+    """Configuration for replay of prepared rollout batches.
+
+    Generation dominates the cost of an on-policy distillation step, so a
+    trajectory that still carries a large teacher-student gap is worth training
+    on more than once. See ``verl.trainer.ppo.replay`` for the sampler.
+
+    Args:
+        enable (bool): Turn replay on. When off, the trainer is unchanged.
+        buffer_batches (int): FIFO depth in rollout batches. ``1`` is
+            current-batch replay: the fresh batch is re-drawn from and then
+            discarded, so a response is never more than
+            ``updates_per_cycle - 1`` updates old. Greater depth reuses
+            trajectories for longer and saves more rollouts, at the cost of a
+            larger gap between the policy that generated a response and the one
+            being trained.
+        updates_per_cycle (int): Optimizer updates per fresh rollout. ``1`` is
+            the fresh-only arm; ``4`` gives one fresh plus three replay updates.
+        token_budget_fraction (float): Each replay update's token budget as a
+            fraction of the fresh batch's training tokens. This is what leaves
+            the sampler something to choose: at ``1.0`` with a depth-one buffer
+            every response would have to be included and the priority exponent
+            would do nothing.
+        priority_signal (str): What ``q_i`` is proportional to. ``length`` uses
+            ``D_i^priority_exponent``, the only signal available before a
+            response exists. ``rms_k1`` uses ``R_i = sqrt(mean_t k_it^2)`` on the
+            batch's own teacher and student log probabilities, which replay gets
+            for free because it draws from an already-scored batch;
+            ``priority_exponent`` is then unused, since ``||G_i||^2 ~ D_i R_i^2``
+            makes the length factor cancel out of ``sqrt(v_i / D_i)``.
+        priority_exponent (float): ``gamma`` in ``q_i ~ D_i^gamma`` over response
+            token length, for ``priority_signal='length'``. ``0.0`` makes every
+            inclusion probability equal to ``token_budget_fraction``, which is
+            the uniform control arm, so the uniform and length-prioritized arms
+            differ only in this value.
+        rms_k1_clamp (float): Bound on ``|k_it|`` before squaring, so a few
+            very low-probability tokens cannot decide a response's priority.
+        min_inclusion_prob (float): ``q_min``, the floor on ``q_i``. Bounds
+            ``1 / q_i`` so one very short response cannot take a huge weight.
+        seed (int): Seed for the Bernoulli inclusion draws.
+        adaptive_depth (bool): Decide each cycle's replay depth from the batch
+            instead of fixing it. ``updates_per_cycle`` then acts only as the
+            safety cap ``K_max``, and each cycle stops as soon as a batch has
+            little left to teach or has drifted too far off-policy. Measured on
+            arms B, C and E3, three replay draws consume only 3-13% of a batch's
+            teacher gap and leave the clip fraction at 1-3%, so a fixed depth of
+            three stops long before either limit binds; the point of this is to
+            find where they do.
+        min_replays_per_cycle (int): Replay draws taken before the gates are
+            consulted. One is the useful value: the first draw is what measures
+            the batch's gap and staleness, so it has to happen before there is
+            anything to decide on.
+        learn_gap_floor_fraction (float): Stop replaying once RMS K1 against the
+            teacher falls below this fraction of the cycle's first replay draw.
+        clip_fraction_ceiling (float): Stop once the PPO clip fraction exceeds
+            this. The observed maximum at depth three is 0.033, and PPO trust
+            region concerns start around 0.2-0.3.
+        ess_floor_fraction (float): Stop once the PPO ratio's effective sample
+            size falls below this share of the draw's tokens.
+        max_optimizer_updates (Optional[int]): End training after this many
+            actor updates, whatever depth the cycles turned out to be. Without
+            it an adaptive arm's total optimization would depend on how often
+            its gates fired, which is exactly what makes it incomparable to a
+            fixed-depth arm.
+        anchor_responses (int): Responses held out of every update in a cycle,
+            fresh and replay alike, and scored after each one to measure what
+            that update bought. Zero disables the anchor and with it
+            ``progress_gate``. Held out of the fresh update too, because
+            otherwise the fresh update's gain would be a training-set number
+            and the replay draws' a held-out one, which are not comparable.
+        progress_gate (bool): Stop replaying on marginal return per unit cost
+            rather than on the level of the remaining teacher gap. Continue
+            while the lower confidence bound of ``d_k = m_k - (C_r / C_f) m_f``
+            is above zero, where ``m`` is the importance-corrected reverse KL the
+            update removed from the anchor and ``C`` its measured wall-clock
+            cost. This asks whether one more replay still beats spending the same
+            seconds on fresh rollouts, which is the decision actually being made,
+            and unlike ``learn_gap_floor_fraction`` it does not require the
+            teacher gap to approach zero: a pair whose gap is structurally large
+            still stops as soon as replay stops paying. Both costs are measured
+            in the run, never assumed.
+        progress_noise_z (float): Standard errors the contrast must clear, its
+            error clustered by anchor response. Testing two point estimates
+            against each other would not say whether replay is statistically the
+            better buy; the contrast puts both terms on the same responses so
+            their correlation enters the error.
+        progress_is_clamp (float): Ceiling on the importance weight
+            ``exp(log pi_theta - log pi_rollout)`` in the anchor estimate. An
+            unbounded ratio lets one token decide it.
+        progress_noop_check (bool): Before the first update, score the anchor
+            with a forward and require it to reproduce the value read from the
+            cached rollout log probabilities. The gate differences those two
+            paths, so a mismatch -- a different engine behind the rollout log
+            probabilities, a token misalignment, or the wrong one of the two sign
+            conventions in this codebase -- would rescale or invert it while
+            leaving no other trace.
+        progress_noop_tolerance (float): Relative gap allowed by that check.
+    """
+
+    enable: bool = False
+    buffer_batches: int = 1
+    updates_per_cycle: int = 4
+    token_budget_fraction: float = 0.25
+    priority_signal: str = "length"
+    priority_exponent: float = 0.0
+    rms_k1_clamp: float = 10.0
+    min_inclusion_prob: float = 0.05
+    seed: int = 42
+    adaptive_depth: bool = False
+    min_replays_per_cycle: int = 1
+    learn_gap_floor_fraction: float = 0.7
+    clip_fraction_ceiling: float = 0.15
+    ess_floor_fraction: float = 0.5
+    max_optimizer_updates: Optional[int] = None
+    anchor_responses: int = 0
+    progress_gate: bool = False
+    progress_noise_z: float = 1.0
+    progress_is_clamp: float = 5.0
+    progress_noop_check: bool = True
+    progress_noop_tolerance: float = 0.01
+
+    def __post_init__(self):
+        if not self.enable:
+            return
+        if self.buffer_batches < 1:
+            raise ValueError(f"replay.buffer_batches must be >= 1, got {self.buffer_batches}")
+        if self.updates_per_cycle < 1:
+            raise ValueError(f"replay.updates_per_cycle must be >= 1, got {self.updates_per_cycle}")
+        if not 0.0 < self.token_budget_fraction <= self.buffer_batches:
+            # A budget above what the buffer holds cannot be met: every response
+            # would be included and prioritization would degrade to plain reuse.
+            raise ValueError(
+                "replay.token_budget_fraction must be in (0, buffer_batches], got "
+                f"{self.token_budget_fraction} with buffer_batches={self.buffer_batches}"
+            )
+        if not 0.0 < self.min_inclusion_prob <= 1.0:
+            raise ValueError(f"replay.min_inclusion_prob must be in (0, 1], got {self.min_inclusion_prob}")
+        if self.priority_exponent < 0.0:
+            raise ValueError(f"replay.priority_exponent must be >= 0, got {self.priority_exponent}")
+        if self.priority_signal not in ("length", "rms_k1"):
+            raise ValueError(
+                f"replay.priority_signal must be 'length' or 'rms_k1', got {self.priority_signal!r}"
+            )
+        if self.rms_k1_clamp <= 0.0:
+            raise ValueError(f"replay.rms_k1_clamp must be > 0, got {self.rms_k1_clamp}")
+        if self.anchor_responses < 0:
+            raise ValueError(f"replay.anchor_responses must be >= 0, got {self.anchor_responses}")
+        if self.progress_gate:
+            if not self.adaptive_depth:
+                # The progress rule is a stopping rule; without adaptive depth
+                # there is nothing for it to stop.
+                raise ValueError("replay.progress_gate requires replay.adaptive_depth")
+            if self.anchor_responses < 2:
+                # The gate needs a standard error across anchor responses, which
+                # a single response cannot supply.
+                raise ValueError(
+                    f"replay.progress_gate requires replay.anchor_responses >= 2, got {self.anchor_responses}"
+                )
+            if self.progress_noise_z < 0.0:
+                raise ValueError(f"replay.progress_noise_z must be >= 0, got {self.progress_noise_z}")
+            if self.progress_is_clamp <= 0.0:
+                raise ValueError(f"replay.progress_is_clamp must be > 0, got {self.progress_is_clamp}")
+            if self.progress_noop_tolerance <= 0.0:
+                raise ValueError(
+                    f"replay.progress_noop_tolerance must be > 0, got {self.progress_noop_tolerance}"
+                )
+        if not self.adaptive_depth:
+            return
+        if not 1 <= self.min_replays_per_cycle < self.updates_per_cycle:
+            # At least one draw is needed to measure the batch, and the floor has
+            # to leave the cap something to cap.
+            raise ValueError(
+                "replay.min_replays_per_cycle must be in [1, updates_per_cycle), got "
+                f"{self.min_replays_per_cycle} with updates_per_cycle={self.updates_per_cycle}"
+            )
+        if not 0.0 < self.learn_gap_floor_fraction <= 1.0:
+            raise ValueError(
