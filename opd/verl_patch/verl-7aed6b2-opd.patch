+"""All-parameter CountSketch artifacts for sharded OPD training gradients."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import torch
+import torch.distributed as dist
+from torch.distributed.fsdp import FullyShardedDataParallel as FSDP
+
+
+JL_CONTRACT = "gaopd_streaming_countsketch_v1"
+TRAINING_GRADIENT_CONTRACT = "gaopd_training_gradient_countsketch_v1"
+ALLOWED_DIMENSIONS = (
+    8192,
+    16384,
+    32768,
+    65536,
+    131072,
+    262144,
+    524288,
+    1048576,
+)
+UINT64_MODULUS = 1 << 64
+SPLITMIX_ADD = 0x9E3779B97F4A7C15
+SPLITMIX_MUL1 = 0xBF58476D1CE4E5B9
+SPLITMIX_MUL2 = 0x94D049BB133111EB
+
+
+@dataclass(frozen=True, slots=True)
+class ProjectionSpec:
+    dimension: int = 32768
+    seed: int = 20260813
+    chunk_size: int = 4_194_304
+
+    def __post_init__(self) -> None:
+        if self.dimension not in ALLOWED_DIMENSIONS:
+            raise ValueError(f"dimension must be one of {ALLOWED_DIMENSIONS}")
+        if self.chunk_size < 1:
+            raise ValueError("chunk_size must be positive")
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "contract": JL_CONTRACT,
+            "dimension": self.dimension,
+            "seed": self.seed,
+            "chunk_size": self.chunk_size,
+            "hash": "sha256_name_seed_splitmix64_v1",
+            "scale": "unit",
+        }
+
+
+def _content_hash(value: Any) -> str:
+    canonical = json.dumps(
+        value,
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+def _name_key(name: str, seed: int) -> int:
+    digest = hashlib.sha256(f"{seed}:{name}".encode()).digest()
+    return int.from_bytes(digest[:8], "little")
+
+
+def _signed64(value: int) -> int:
+    value %= UINT64_MODULUS
+    return value if value < (1 << 63) else value - UINT64_MODULUS
+
+
+def _logical_rshift(values: torch.Tensor, bits: int) -> torch.Tensor:
+    return (values >> bits) & ((1 << (64 - bits)) - 1)
+
+
+def _mix64(values: torch.Tensor) -> torch.Tensor:
+    mixed = values + _signed64(SPLITMIX_ADD)
+    mixed = (
+        mixed ^ _logical_rshift(mixed, 30)
+    ) * _signed64(SPLITMIX_MUL1)
+    mixed = (
+        mixed ^ _logical_rshift(mixed, 27)
+    ) * _signed64(SPLITMIX_MUL2)
+    return mixed ^ _logical_rshift(mixed, 31)
+
+
+def bucket_sign(
+    name: str,
+    indices: torch.Tensor,
+    spec: ProjectionSpec,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    if indices.dtype != torch.int64:
+        indices = indices.to(dtype=torch.int64)
+    mixed = _mix64(indices + _signed64(_name_key(name, spec.seed)))
+    buckets = torch.bitwise_and(mixed, spec.dimension - 1)
+    signs = _logical_rshift(mixed, 63).to(dtype=torch.float32).mul_(2).sub_(1)
+    return buckets, signs
+
+
+def accumulate_gradient_segment(
+    sketch: torch.Tensor,
+    *,
+    name: str,
+    gradient: torch.Tensor,
+    global_start: int,
+    spec: ProjectionSpec,
+) -> torch.Tensor:
+    """Accumulate one contiguous original-parameter shard into ``sketch``."""
+    exact_squared_norm = torch.zeros(
+        (),
+        dtype=torch.float64,
+        device=sketch.device,
+    )
+    flat_gradient = gradient.detach().reshape(-1)
+    for local_start in range(0, flat_gradient.numel(), spec.chunk_size):
+        local_stop = min(local_start + spec.chunk_size, flat_gradient.numel())
+        values = flat_gradient[local_start:local_stop].to(
+            device=sketch.device,
+            dtype=torch.float32,
+        )
+        indices = torch.arange(
+            global_start + local_start,
+            global_start + local_stop,
+            dtype=torch.int64,
+            device=sketch.device,
+        )
+        buckets, signs = bucket_sign(name, indices, spec)
+        sketch.scatter_add_(0, buckets, values * signs)
+        exact_squared_norm += values.square().sum(dtype=torch.float64)
+    return exact_squared_norm
+
+
+def clean_fsdp_parameter_name(name: str) -> str:
+    """Map FSDP wrapper names back to Hugging Face ``named_parameters`` names."""
+    return name.replace("_fsdp_wrapped_module.", "")
+
+
+def projection_identity(
+    spec: ProjectionSpec,
+    layout: list[dict[str, Any]],
+) -> str:
+    return _content_hash(
+        {
+            "projection": spec.as_dict(),
+            "parameter_layout": layout,
+            "tied_policy": "unique_parameter_identity",
+        }
+    )
+
+
+def _parameter_metadata(
+    module: FSDP,
+) -> tuple[
+    dict[int, str],
+    dict[int, tuple[list[int], int]],
+    list[tuple[Any, Any]],
+    list[dict[str, Any]],
+    Any,
+]:
+    name_by_id: dict[int, str] = {}
+    ordered_parameters = []
+    for raw_name, parameter in module.named_parameters():
+        identity = id(parameter)
+        if identity in name_by_id:
+            continue
+        name_by_id[identity] = clean_fsdp_parameter_name(raw_name)
+        ordered_parameters.append(parameter)
+
+    shape_by_id: dict[int, tuple[list[int], int]] = {}
+    handles: list[tuple[Any, Any]] = []
+    shard_process_group = None
+    root_handles = getattr(module, "_all_handles", None)
+    if not root_handles:
+        raise RuntimeError("FSDP root handle metadata is unavailable")
+    for handle in root_handles:
+        flat_parameter = handle.flat_param
+        parameters = getattr(flat_parameter, "_params", None)
+        shard_infos = getattr(flat_parameter, "_shard_param_infos", None)
+        if parameters is None or shard_infos is None:
+            raise RuntimeError(
+                "gradient sketching requires FSDP1 use_orig_params=True"
+            )
+        for parameter, shape, numel in zip(
+            parameters,
+            flat_parameter._shapes,
+            flat_parameter._numels,
+            strict=True,
+        ):
+            shape_by_id[id(parameter)] = (list(shape), int(numel))
+        handles.append((flat_parameter, shard_infos))
+        if shard_process_group is None:
+            shard_process_group = handle.process_group
+        elif shard_process_group is not handle.process_group:
+            raise RuntimeError(
+                "FSDP handles use different shard process groups"
+            )
+
+    missing = [
+        name_by_id[id(parameter)]
+        for parameter in ordered_parameters
+        if id(parameter) not in shape_by_id
+    ]
+    if missing:
+        raise RuntimeError(
+            "FSDP metadata missing canonical parameters: " + ", ".join(missing[:5])
+        )
+    layout = [
+        {
+            "name": name_by_id[id(parameter)],
+            "shape": shape_by_id[id(parameter)][0],
+            "numel": shape_by_id[id(parameter)][1],
+        }
+        for parameter in ordered_parameters
+    ]
+    return (
+        name_by_id,
+        shape_by_id,
+        handles,
+        layout,
+        shard_process_group,
+    )
+
+
+def project_fsdp1_gradients(
+    module: FSDP,
+    spec: ProjectionSpec,
+) -> tuple[torch.Tensor, float, list[dict[str, Any]], dict[str, int]]:
+    """Project an averaged FSDP1 gradient without gathering full parameters.
+
+    ``_shard_param_infos`` identifies the original-parameter index represented
+    by every local gradient segment. Each coordinate is sketched exactly once,
+    and an all-reduce reconstructs the full pre-clipping gradient projection.
+    """
+    (
+        name_by_id,
+        _shape_by_id,
+        handles,
+        layout,
+        shard_process_group,
+    ) = _parameter_metadata(module)
+    device = next(module.parameters()).device
+    sketch = torch.zeros(spec.dimension, dtype=torch.float32, device=device)
+    exact_squared_norm = torch.zeros((), dtype=torch.float64, device=device)
+    supported_dtypes = ("float16", "bfloat16", "float32", "float64")
+    dtype_count_tensor = torch.zeros(
+        len(supported_dtypes),
+        dtype=torch.int64,
+        device=device,
+    )
+
+    for flat_parameter, shard_infos in handles:
+        for parameter, shard_info in zip(
+            flat_parameter._params,
+            shard_infos,
+            strict=True,
+        ):
+            if not shard_info.in_shard or parameter.grad is None:
+                continue
+            gradient = parameter.grad.detach().reshape(-1)
+            expected_numel = int(shard_info.numel_in_shard)
+            if gradient.numel() != expected_numel:
+                raise RuntimeError(
+                    f"gradient shard for {name_by_id[id(parameter)]} has "
+                    f"{gradient.numel()} values, expected {expected_numel}"
+                )
+            dtype_name = str(gradient.dtype).removeprefix("torch.")
+            if dtype_name not in supported_dtypes:
+                raise RuntimeError(
+                    f"unsupported gradient dtype for sketching: {dtype_name}"
+                )
+            dtype_count_tensor[supported_dtypes.index(dtype_name)] += gradient.numel()
+            global_start = int(shard_info.intra_param_start_idx)
+            exact_squared_norm += accumulate_gradient_segment(
+                sketch,
+                name=name_by_id[id(parameter)],
+                gradient=gradient,
+                global_start=global_start,
+                spec=spec,
+            )
+
+    if dist.is_available() and dist.is_initialized():
+        dist.all_reduce(
+            sketch,
+            op=dist.ReduceOp.SUM,
+            group=shard_process_group,
+        )
+        dist.all_reduce(
+            exact_squared_norm,
+            op=dist.ReduceOp.SUM,
+            group=shard_process_group,
+        )
+        dist.all_reduce(
+            dtype_count_tensor,
+            op=dist.ReduceOp.SUM,
+            group=shard_process_group,
+        )
+    dtype_counts = {
+        name: int(count)
+        for name, count in zip(
+            supported_dtypes,
+            dtype_count_tensor.detach().cpu().tolist(),
+            strict=True,
+        )
+        if count
+    }
+
+    return (
+        sketch.detach().cpu(),
+        math.sqrt(exact_squared_norm.item()),
+        layout,
+        dtype_counts,
+    )
+
+
+def save_training_gradient_artifact(
+    output_dir: str | Path,
+    *,
+    step: int,
+    sketch: torch.Tensor,
+    exact_norm: float,
+    layout: list[dict[str, Any]],
+    dtype_counts: dict[str, int],
+    spec: ProjectionSpec,
+    metadata: dict[str, Any],
+) -> tuple[Path, str]:
+    destination = Path(output_dir)
+    destination.mkdir(parents=True, exist_ok=True)
+    projection_id = projection_identity(spec, layout)
+    manifest = {
+        "schema_version": 1,
+        "kind": TRAINING_GRADIENT_CONTRACT,
+        "precision_contract": "fp32_master_bf16_autocast_v1",
+        "projection_contract": JL_CONTRACT,
+        "projection": spec.as_dict(),
+        "projection_id": projection_id,
+        "parameter_scope": "all_unique_parameters",
+        "tied_policy": "unique_parameter_identity",
+        "name_policy": "huggingface_unwrapped",
+        "parameter_layout": layout,
+        "parameter_count": sum(row["numel"] for row in layout),
+        "rank_reduce": "sum_complementary_fsdp_shards",
+        "grad_state": "post_fsdp_mean_pre_clip",
+        "gradient_semantics": (
+            "global FSDP-averaged actor gradient before clipping "
+            "and optimizer step"
+        ),
+        **metadata,
+    }
+    manifest_path = destination / "manifest.json"
+    if manifest_path.exists():
+        existing = json.loads(manifest_path.read_text(encoding="utf-8"))
+        if existing != manifest:
+            raise RuntimeError(
+                f"gradient sketch manifest changed within one run: {manifest_path}"
+            )
+    else:
+        temporary_manifest = manifest_path.with_suffix(".json.tmp")
+        temporary_manifest.write_text(
+            json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True)
+            + "\n",
+            encoding="utf-8",
+        )
+        os.replace(temporary_manifest, manifest_path)
+
+    artifact = {
+        "schema_version": 1,
+        "kind": TRAINING_GRADIENT_CONTRACT,
+        "precision_contract": "fp32_master_bf16_autocast_v1",
+        "projection_contract": JL_CONTRACT,
+        "step": step,
+        "projection": spec.as_dict(),
+        "projection_id": projection_id,
+        "sketch": sketch.to(dtype=torch.float32),
+        "exact_grad_norm": exact_norm,
+        "projected_grad_norm": float(torch.linalg.vector_norm(sketch.float())),
+        "gradient_dtype_coordinate_counts": dtype_counts,
+        "rank_reduce": "sum_complementary_fsdp_shards",
+        "grad_state": "post_fsdp_mean_pre_clip",
+        **metadata,
+    }
+    output_path = destination / f"step_{step:06d}.pt"
+    if output_path.exists():
+        raise FileExistsError(
+            f"refusing to overwrite gradient sketch artifact: {output_path}"
+        )
+    temporary_path = output_path.with_suffix(".pt.tmp")
+    torch.save(artifact, temporary_path)
+    os.replace(temporary_path, output_path)
+    return output_path, projection_id
