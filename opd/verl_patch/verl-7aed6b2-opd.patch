+import importlib.util
+from pathlib import Path
+
+
+def _load_sitecustomize(monkeypatch):
+    monkeypatch.setenv("OPD_EXTRA_LOGPROB_TOKEN_IDS", "151645,151643")
+    path = (
+        Path(__file__).resolve().parents[2].parent
+        / "opd-code"
+        / "scripts"
+        / "opd"
+        / "sitecustomize.py"
+    )
+    spec = importlib.util.spec_from_file_location("opd_sitecustomize_test", path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_extra_token_patch_rebinds_already_imported_call_sites(monkeypatch):
+    import vllm.logprobs as logprobs_mod
+    import vllm.v1.engine.logprobs as engine_logprobs_mod
+    import vllm.v1.worker.gpu.sample.prompt_logprob as prompt_logprob_mod
+    from vllm.v1.worker.gpu.sample import logprob as logprob_mod
+    from vllm.v1.worker.gpu_model_runner import GPUModelRunner
+
+    original_compute = prompt_logprob_mod.compute_topk_logprobs
+    original_append = engine_logprobs_mod.append_logprobs_for_next_position
+
+    module = _load_sitecustomize(monkeypatch)
+    module.patch_extra_prompt_logprob_tokens()
+
+    assert getattr(logprob_mod.compute_topk_logprobs, "_opd_extra_tokens", False)
+    assert prompt_logprob_mod.compute_topk_logprobs is logprob_mod.compute_topk_logprobs
+    assert prompt_logprob_mod.compute_topk_logprobs is not original_compute
+    assert getattr(logprobs_mod.append_logprobs_for_next_position, "_opd_extra_tokens", False)
+    assert getattr(
+        engine_logprobs_mod.append_logprobs_for_next_position, "_opd_extra_tokens", False
+    )
+    assert engine_logprobs_mod.append_logprobs_for_next_position is not original_append
+    assert getattr(
+        engine_logprobs_mod.LogprobsProcessor._update_prompt_logprobs,
+        "_opd_extra_tokens",
+        False,
+    )
+    assert getattr(
+        GPUModelRunner._get_prompt_logprobs_dict,
+        "_opd_extra_tokens",
+        False,
+    )
