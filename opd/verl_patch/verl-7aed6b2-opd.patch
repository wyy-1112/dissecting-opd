index 0000000..3ca45d8
--- /dev/null
+++ b/tests/trainer/test_replay_buffer_on_cpu.py
@@ -0,0 +1,261 @@
+"""Tests for the FIFO replay buffer over real ``DataProto`` batches.
+
+These cover the parts the sampler tests cannot: that eviction keeps the
+intended batches, that drawn rows carry the weight belonging to them, and that
+padding a variable-size draw up to the data-parallel width leaves the
+token-mean denominator unchanged.
+"""
+
+import numpy as np
+import pytest
+import torch
+from tensordict import TensorDict
+
+from verl.protocol import DataProto
+from verl.trainer.ppo.replay import (
+    REPLAY_COST_KEY,
+    FIFOReplayBuffer,
+    pad_replay_batch_for_data_parallel,
+    solve_inclusion_probabilities,
+)
+from verl.utils.replay_weights import REPLAY_WEIGHT_KEY, weighted_token_count
+
+GAMMA = 0.75
+RESPONSE_WIDTH = 64
+PROMPT_WIDTH = 8
+
+
+def _make_batch(row_ids, lengths):
+    """Build a batch shaped like a prepared rollout batch, tagged by row id."""
+    row_ids = np.asarray(row_ids)
+    lengths = np.asarray(lengths)
+    response_mask = torch.zeros(row_ids.size, RESPONSE_WIDTH, dtype=torch.int64)
+    for i, length in enumerate(lengths):
+        response_mask[i, :length] = 1
+    attention_mask = torch.cat(
+        [torch.ones(row_ids.size, PROMPT_WIDTH, dtype=torch.int64), response_mask], dim=-1
+    )
+    batch = TensorDict(
+        {
+            "row_id": torch.as_tensor(row_ids, dtype=torch.int64),
+            "response_mask": response_mask,
+            "attention_mask": attention_mask,
+            REPLAY_COST_KEY: response_mask.flatten(1).sum(-1).float(),
+        },
+        batch_size=(row_ids.size,),
+    )
+    # The trainer attaches these per-row counts to every batch it is about to
+    # train on, so a buffered batch carries them too.
+    meta_info = {
+        "global_token_num": attention_mask.sum(-1).tolist(),
+        "images_seqlens": [],
+    }
+    return DataProto(batch=batch, non_tensor_batch={}, meta_info=meta_info)
+
+
+def _make_random_batch(rng, start_id, size=32):
+    row_ids = np.arange(start_id, start_id + size)
+    lengths = rng.integers(4, RESPONSE_WIDTH + 1, size=size)
+    return _make_batch(row_ids, lengths)
+
+
+def test_buffer_keeps_only_the_most_recent_batches():
+    rng = np.random.default_rng(0)
+    buffer = FIFOReplayBuffer(capacity=4)
+
+    for i in range(6):
+        buffer.push(_make_random_batch(rng, start_id=100 * i))
+
+    assert len(buffer) == 4
+    assert buffer.is_full
+    assert buffer.num_responses == 4 * 32
+    # The two oldest pushes have been evicted.
+    held = {int(v) // 100 for b in buffer._batches for v in b.batch["row_id"]}
+    assert held == {2, 3, 4, 5}
+
+
+def test_buffer_fills_before_reporting_full():
+    rng = np.random.default_rng(1)
+    buffer = FIFOReplayBuffer(capacity=4)
+
+    for i in range(3):
+        buffer.push(_make_random_batch(rng, start_id=100 * i))
+        assert not buffer.is_full
+    buffer.push(_make_random_batch(rng, start_id=300))
+    assert buffer.is_full
+
+
+def test_push_copies_so_later_mutation_does_not_leak():
+    buffer = FIFOReplayBuffer(capacity=2)
+    batch = _make_batch([1, 2], [8, 16])
+    buffer.push(batch)
+
+    # The trainer keeps using its own object after buffering it.
+    batch.batch["row_id"] += 1000
+    batch.meta_info["temperature"] = 0.5
+
+    assert buffer._batches[0].batch["row_id"].tolist() == [1, 2]
+    assert "temperature" not in buffer._batches[0].meta_info
+
+
+def test_push_requires_costs():
+    batch = _make_batch([1], [8])
+    batch.batch.pop(REPLAY_COST_KEY)
+
+    with pytest.raises(KeyError):
+        FIFOReplayBuffer(capacity=2).push(batch)
+
+
+def test_sampled_rows_carry_their_own_weights():
+    rng = np.random.default_rng(2)
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_random_batch(rng, start_id=100 * i))
+
+    costs = buffer.costs()
+    budget = 0.25 * costs.sum()
+    selected, stats = buffer.sample(
+        budget, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(3)
+    )
+
+    q = solve_inclusion_probabilities(costs, budget, priority_exponent=GAMMA, min_inclusion_prob=0.02)
+    pooled_row_ids = np.concatenate([b.batch["row_id"].numpy() for b in buffer._batches])
+    position_of_row = {int(r): i for i, r in enumerate(pooled_row_ids)}
+
+    # Every drawn row must be weighted by the reciprocal of its own inclusion
+    # probability; a misaligned concat would silently pair rows with the wrong
+    # weight and bias the update.
+    weights = selected.batch[REPLAY_WEIGHT_KEY].numpy()
+    for row_id, weight in zip(selected.batch["row_id"].numpy(), weights, strict=True):
+        assert weight == pytest.approx(1.0 / q[position_of_row[int(row_id)]], rel=1e-5)
+
+    assert stats["replay/selected_responses"] == len(selected)
+    assert stats["replay/target_tokens"] == pytest.approx(budget)
+
+
+def test_draw_spanning_batches_rebuilds_per_row_meta_info():
+    """A draw takes rows from several batches, so per-row meta-info must be rebuilt.
+
+    ``DataProto.concat`` refuses to merge batches whose meta-info disagrees, and
+    ``global_token_num`` disagrees between any two rollout batches. Leaving it on
+    the buffered batches crashed the first live run at the first replay update.
+    """
+    rng = np.random.default_rng(8)
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_random_batch(rng, start_id=100 * i))
+    assert all("global_token_num" not in b.meta_info for b in buffer._batches)
+
+    selected, _ = buffer.sample(
+        0.5 * buffer.total_tokens, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(9)
+    )
+
+    # Rows really did come from more than one buffered batch.
+    assert len({int(r) // 100 for r in selected.batch["row_id"].numpy()}) > 1
+    assert selected.meta_info["global_token_num"] == selected.batch["attention_mask"].sum(-1).tolist()
+
+
+def test_padding_extends_per_row_meta_info():
+    buffer = FIFOReplayBuffer(capacity=1)
+    buffer.push(_make_batch(np.arange(6), [8, 16, 24, 32, 40, 48]))
+    selected, _ = buffer.sample(
+        0.5 * buffer.total_tokens, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(10)
+    )
+
+    # A draw's size is random, so the width is picked to guarantee a partial
+    # last shard rather than relying on the draw to be awkward.
+    padded, pad_size = pad_replay_batch_for_data_parallel(selected, len(selected) + 1)
+
+    assert pad_size > 0
+    # Padded rows are forwarded and back-propagated like any other, so the FLOPs
+    # accounting has to see them even though their loss weight is zero.
+    assert padded.meta_info["global_token_num"] == padded.batch["attention_mask"].sum(-1).tolist()
+    assert len(padded.meta_info["global_token_num"]) == len(padded)
+
+
+def test_sampled_rows_are_distinct_and_come_from_the_buffer():
+    rng = np.random.default_rng(4)
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_random_batch(rng, start_id=100 * i))
+
+    selected, _ = buffer.sample(
+        0.25 * buffer.total_tokens, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(5)
+    )
+
+    drawn = selected.batch["row_id"].numpy()
+    pooled = np.concatenate([b.batch["row_id"].numpy() for b in buffer._batches])
+    assert len(set(drawn.tolist())) == drawn.size
+    assert set(drawn.tolist()) <= set(pooled.tolist())
+
+
+def test_priority_draws_longer_responses_than_uniform():
+    rng = np.random.default_rng(6)
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_random_batch(rng, start_id=100 * i, size=64))
+    budget = 0.25 * buffer.total_tokens
+
+    uniform_lengths = []
+    priority_lengths = []
+    for trial in range(40):
+        _, uniform_stats = buffer.sample(
+            budget, priority_exponent=0.0, min_inclusion_prob=0.02, rng=np.random.default_rng(1000 + trial)
+        )
+        _, priority_stats = buffer.sample(
+            budget, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(1000 + trial)
+        )
+        uniform_lengths.append(uniform_stats["replay/selected_mean_length"])
+        priority_lengths.append(priority_stats["replay/selected_mean_length"])
+
+    assert np.mean(priority_lengths) > np.mean(uniform_lengths)
+
+
+def test_weighted_tokens_recover_the_buffer_total_on_average():
+    rng = np.random.default_rng(7)
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_random_batch(rng, start_id=100 * i, size=64))
+    budget = 0.25 * buffer.total_tokens
+
+    weighted = [
+        buffer.sample(budget, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(seed))[1][
+            "replay/weighted_tokens"
+        ]
+        for seed in range(300)
+    ]
+
+    # The weighted count is the denominator the token-mean loss is divided by,
+    # so it has to track the buffer it is meant to represent.
+    assert np.mean(weighted) == pytest.approx(buffer.total_tokens, rel=0.02)
+
+
+@pytest.mark.parametrize("dp_size", [1, 8])
+def test_padding_preserves_the_weighted_denominator(dp_size):
+    rng = np.random.default_rng(8)
+    buffer = FIFOReplayBuffer(capacity=4)
+    for i in range(4):
+        buffer.push(_make_random_batch(rng, start_id=100 * i, size=37))
+    selected, _ = buffer.sample(
+        0.25 * buffer.total_tokens, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(9)
+    )
+    before = weighted_token_count(selected.batch["response_mask"], selected.batch[REPLAY_WEIGHT_KEY])
+
+    padded, pad_size = pad_replay_batch_for_data_parallel(selected, dp_size)
+
+    assert len(padded) % dp_size == 0
+    assert len(padded) == len(selected) + pad_size
+    after = weighted_token_count(padded.batch["response_mask"], padded.batch[REPLAY_WEIGHT_KEY])
+    assert after.item() == pytest.approx(before.item(), rel=1e-6)
+    if pad_size > 0:
+        assert torch.all(padded.batch[REPLAY_WEIGHT_KEY][-pad_size:] == 0.0)
+        assert torch.all(padded.batch[REPLAY_WEIGHT_KEY][:-pad_size] > 0.0)
+
+
+def test_empty_buffer_yields_no_sample():
+    selected, stats = FIFOReplayBuffer(capacity=4).sample(
+        1000.0, priority_exponent=GAMMA, min_inclusion_prob=0.02, rng=np.random.default_rng(10)
+    )
+
+    assert selected is None
+    assert stats == {}
