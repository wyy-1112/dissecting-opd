+import pytest
+import torch
+
+from verl.trainer.distillation.loss_masks import build_response_loss_mask
+
+
+def test_prefix_mask_preserves_shape_and_dtype():
+    response_mask = torch.tensor(
+        [[1, 1, 1, 1, 0], [1, 1, 0, 0, 0]],
+        dtype=torch.int64,
+    )
+
+    result = build_response_loss_mask(
+        response_mask,
+        max_prefix_tokens=3,
+    )
+
+    assert result.dtype == response_mask.dtype
+    assert torch.equal(
+        result,
+        torch.tensor([[1, 1, 1, 0, 0], [1, 1, 0, 0, 0]]),
+    )
+
+
+def test_prefix_plus_per_sequence_suffix_mask():
+    response_mask = torch.tensor(
+        [[True, True, True, True, True, False], [True, True, True, False, False, False]]
+    )
+
+    result = build_response_loss_mask(
+        response_mask,
+        max_prefix_tokens=2,
+        suffix_tokens=2,
+    )
+
+    assert torch.equal(
+        result,
+        torch.tensor(
+            [
+                [True, True, False, True, True, False],
+                [True, True, True, False, False, False],
+            ]
+        ),
+    )
+
+
+def test_one_dimensional_mask_and_noop_identity():
+    response_mask = torch.tensor([1, 1, 1, 0])
+
+    assert build_response_loss_mask(response_mask) is response_mask
+    assert torch.equal(
+        build_response_loss_mask(response_mask, suffix_tokens=1),
+        torch.tensor([0, 0, 1, 0]),
+    )
+
+
+@pytest.mark.parametrize(
+    ("prefix", "suffix"),
+    [(0, 0), (-1, 0), (None, -1)],
+)
+def test_invalid_token_limits(prefix, suffix):
+    with pytest.raises(ValueError):
+        build_response_loss_mask(
+            torch.ones(4),
+            max_prefix_tokens=prefix,
+            suffix_tokens=suffix,
+        )
