    "influence": "I_ij = L_j(base) - L_j(theta_i); positive closes the gap",
    "scalar_fit": "cosine, alpha = <v_i,v_T>/<v_T,v_T>, and the residual after removing alpha*v_T, on the report's centered Fisher vectors"
  },
  "limitations": {
